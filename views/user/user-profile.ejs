<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>ShopyGo | Account Settings</title>
  <!-- Bootstrap 5 + Icons + Google Fonts -->
   <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛒</text></svg>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', sans-serif;
    }

    body {
      background: #f8fafc;
      color: #0f172a;
    }

    :root {
      --primary-blue: #2563eb;
      --primary-dark: #1d4ed8;
      --accent-blue: #3b82f6;
      --soft-bg: #eff6ff;
      --border-light: #e9eff5;
    }

    /* Navbar */
    .navbar {
      background: white;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
      border-bottom: 1px solid var(--border-light);
      padding: 12px 0;
    }
    .navbar-brand {
      font-weight: 800;
      font-size: 1.6rem;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      text-decoration: none;
    }
    .nav-icon {
      color: #1e293b;
      font-size: 1.2rem;
      transition: 0.2s;
      text-decoration: none;
      position: relative;
    }
    .nav-icon:hover {
      color: var(--primary-blue);
    }
    .cart-badge {
      position: absolute;
      top: -8px;
      right: -12px;
      background: var(--primary-blue);
      color: white;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 20px;
    }

    /* Breadcrumb */
    .breadcrumb-custom {
      margin: 20px 0 24px;
      font-size: 0.8rem;
    }
    .breadcrumb-custom a {
      color: #6c7a91;
      text-decoration: none;
    }
    .breadcrumb-custom a:hover {
      color: var(--primary-blue);
    }

    /* Page Layout */
    .settings-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      margin-bottom: 50px;
    }
    .settings-sidebar {
      flex: 0 0 280px;
      background: white;
      border-radius: 24px;
      border: 1px solid var(--border-light);
      padding: 20px 0;
      height: fit-content;
      position: sticky;
      top: 90px;
    }
    .settings-sidebar-item {
      padding: 12px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: #475569;
      cursor: pointer;
      transition: 0.2s;
      border-left: 3px solid transparent;
    }
    .settings-sidebar-item i {
      width: 22px;
      font-size: 1rem;
    }
    .settings-sidebar-item:hover {
      background: var(--soft-bg);
      color: var(--primary-blue);
    }
    .settings-sidebar-item.active {
      background: var(--soft-bg);
      color: var(--primary-blue);
      border-left-color: var(--primary-blue);
      font-weight: 600;
    }
    .settings-content {
      flex: 1;
      background: white;
      border-radius: 24px;
      border: 1px solid var(--border-light);
      padding: 28px 32px;
    }
    .settings-section {
      display: none;
    }
    .settings-section.active {
      display: block;
    }
    .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-light);
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 6px;
      display: block;
    }
    .form-control, .form-select {
      border: 1.5px solid var(--border-light);
      border-radius: 16px;
      padding: 10px 16px;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      outline: none;
    }
    .form-control:disabled {
      background: #f1f5f9;
      color: #94a3b8;
    }
    .btn-save {
      background: var(--primary-blue);
      border: none;
      border-radius: 40px;
      padding: 10px 28px;
      font-weight: 600;
      color: white;
      transition: 0.2s;
    }
    .btn-save:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }
    .btn-outline-secondary {
      border: 1.5px solid var(--border-light);
      background: white;
      border-radius: 40px;
      padding: 10px 24px;
      font-weight: 500;
      font-size: 0.8rem;
      transition: 0.2s;
    }
    .btn-outline-secondary:hover {
      border-color: var(--primary-blue);
      color: var(--primary-blue);
    }
    .btn-danger-custom {
      background: #ef4444;
      border: none;
      border-radius: 40px;
      padding: 10px 28px;
      font-weight: 600;
      color: white;
      transition: 0.2s;
    }
    .btn-danger-custom:hover {
      background: #dc2626;
    }
    .address-card {
      background: #fafcff;
      border: 1px solid var(--border-light);
      border-radius: 20px;
      padding: 16px;
      margin-bottom: 12px;
      transition: 0.2s;
    }
    .address-card:hover {
      border-color: var(--primary-blue);
    }
    .address-card .address-label {
      display: inline-block;
      padding: 2px 12px;
      border-radius: 20px;
      font-size: 0.65rem;
      font-weight: 600;
      background: var(--soft-bg);
      color: var(--primary-blue);
      margin-bottom: 4px;
    }
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 50px;
      height: 24px;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #cbd5e1;
      transition: 0.3s;
      border-radius: 34px;
    }
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.3s;
      border-radius: 50%;
    }
    input:checked + .toggle-slider {
      background-color: var(--primary-blue);
    }
    input:checked + .toggle-slider:before {
      transform: translateX(26px);
    }
    .notification-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid var(--border-light);
    }
    .notification-item:last-child {
      border-bottom: none;
    }

    /* Toast */
    .toast-msg {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary-blue);
      color: white;
      padding: 10px 20px;
      border-radius: 48px;
      font-size: 0.8rem;
      z-index: 1100;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      animation: slideUp 0.25s ease;
    }
    .toast-msg.error {
      background: #ef4444;
    }
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }

    /* Footer */
    footer {
      background: #0f172a;
      color: #cbd5e1;
      padding: 40px 0 24px;
      margin-top: 60px;
    }
    footer a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.8rem;
    }
    footer a:hover {
      color: white;
    }
    .copyright {
      text-align: center;
      border-top: 1px solid #1e293b;
      padding-top: 24px;
      margin-top: 32px;
      font-size: 0.7rem;
    }

    .profile-avatar-sm {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .profile-avatar-sm img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    .address-source-badge {
      font-size: 0.6rem;
      padding: 2px 10px;
      border-radius: 20px;
      background: #e2e8f0;
      color: #475569;
      margin-left: 8px;
    }

    .address-source-badge.order {
      background: #dbeafe;
      color: #1e40af;
    }

    .address-source-badge.saved {
      background: #d1fae5;
      color: #065f46;
    }

    @media (max-width: 768px) {
      .settings-sidebar {
        flex: 0 0 100%;
        position: static;
      }
      .settings-content {
        padding: 20px;
      }
    }
  </style>
</head>
