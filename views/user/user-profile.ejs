<script>
  const API_URL = 'http://localhost:5000/api';
  let currentUser = null;
  let allAddresses = [];

  // ================================================================
  // LOAD USER DATA FROM BACKEND
  // ================================================================
  async function loadUserData() {
    try {
      const token = localStorage.getItem('token');
      const userStr = localStorage.getItem('user');
      
      if (!token || !userStr) {
        window.location.href = '/user/login';
        return;
      }

      currentUser = JSON.parse(userStr);
      console.log('👤 User data:', currentUser);

      // Update UI with user data
      const fullName = currentUser.name || '';
      const nameParts = fullName.split(' ');
      document.getElementById('firstName').value = nameParts[0] || '';
      document.getElementById('lastName').value = nameParts.slice(1).join(' ') || '';
      document.getElementById('email').value = currentUser.email || '';
      document.getElementById('phone').value = currentUser.phone || '';
      document.getElementById('dob').value = currentUser.dob || '';
      document.getElementById('bio').value = currentUser.bio || '';

      // Update avatar
      const initial = currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U';
      document.getElementById('avatarLetter').textContent = initial;

      // Load preferences
      if (currentUser.language) {
        document.getElementById('language').value = currentUser.language;
      }
      if (currentUser.currency) {
        document.getElementById('currency').value = currentUser.currency;
      }
      if (currentUser.theme === 'dark') {
        document.getElementById('darkModeToggle').checked = true;
        document.body.style.background = '#1e293b';
        document.body.style.color = '#f1f5f9';
      }

      // Load notifications
      if (currentUser.notifications) {
        document.getElementById('orderUpdates').checked = currentUser.notifications.order !== false;
        document.getElementById('promotions').checked = currentUser.notifications.promo !== false;
        document.getElementById('newsletter').checked = currentUser.notifications.newsletter || false;
        document.getElementById('smsAlerts').checked = currentUser.notifications.sms !== false;
      }

      // Load 2FA status
      if (currentUser.twoFactor === 'enabled') {
        document.getElementById('twoFactorToggle').checked = true;
      }

      // Load addresses from both user and orders
      await loadAllAddresses();

      // Update cart count
      loadCartCount();

    } catch (error) {
      console.error('❌ Error loading user data:', error);
      showToast('Failed to load profile', true);
    }
  }

  // ================================================================
  // LOAD ALL ADDRESSES (From User + Orders)
  // ================================================================
  async function loadAllAddresses() {
    try {
      const token = localStorage.getItem('token');
      const userId = currentUser._id;

      // 1. Get saved addresses from user profile
      const savedAddresses = currentUser.addresses || [];
      console.log('📦 Saved addresses:', savedAddresses);

      // 2. Get addresses from orders
      const ordersResponse = await fetch(`${API_URL}/orders?userId=${userId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      let orderAddresses = [];
      if (ordersResponse.ok) {
        const orders = await ordersResponse.json();
        console.log('📦 Orders found:', orders.length);
        
        // Extract unique addresses from orders
        const addressMap = new Map();
        orders.forEach(order => {
          if (order.shippingAddress) {
            const addr = order.shippingAddress;
            const key = `${addr.address}-${addr.city}-${addr.state}-${addr.pincode}`;
            if (!addressMap.has(key)) {
              addressMap.set(key, {
                ...addr,
                source: 'order',
                orderId: order.orderNumber || order._id,
                orderDate: order.createdAt
              });
            }
          }
        });
        orderAddresses = Array.from(addressMap.values());
        console.log('📦 Unique order addresses:', orderAddresses.length);
      }

      // 3. Combine addresses (saved first, then order addresses)
      const combined = [
        ...savedAddresses.map(addr => ({ ...addr, source: 'saved' })),
        ...orderAddresses
      ];

      // Remove duplicates based on address string
      const uniqueMap = new Map();
      combined.forEach(addr => {
        const key = addr.address || `${addr.street}, ${addr.city}, ${addr.state}, ${addr.pincode}`;
        if (!uniqueMap.has(key)) {
          uniqueMap.set(key, addr);
        }
      });

      allAddresses = Array.from(uniqueMap.values());
      console.log('✅ Total unique addresses:', allAddresses.length);

      // Render addresses
      renderAddresses();

    } catch (error) {
      console.error('❌ Error loading addresses:', error);
      showToast('Failed to load addresses', true);
    }
  }

  // ================================================================
  // RENDER ADDRESSES
  // ================================================================
  function renderAddresses() {
    const container = document.getElementById('addressesList');

    if (allAddresses.length === 0) {
      container.innerHTML = `
        <div class="text-center py-4 text-muted">
          <i class="fas fa-map-marker-alt fs-2 d-block mb-2"></i>
          No addresses found. Add a new address or place an order to save your shipping address.
        </div>
      `;
      return;
    }

    container.innerHTML = allAddresses.map((addr, index) => {
      const sourceBadge = addr.source === 'order' 
        ? '<span class="address-source-badge order"><i class="fas fa-box me-1"></i>From Order</span>'
        : '<span class="address-source-badge saved"><i class="fas fa-check me-1"></i>Saved</span>';

      const label = addr.label || 'Address';
      const address = addr.address || `${addr.street}, ${addr.city}, ${addr.state} - ${addr.pincode}`;
      const phone = addr.phone || currentUser.phone || '';

      return `
        <div class="address-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="address-label">${label}</div>
              <div class="small text-muted">${address}</div>
              ${phone ? `<div class="small text-muted mt-1"><i class="fas fa-phone me-1"></i>${phone}</div>` : ''}
              ${addr.orderId ? `<div class="small text-muted"><i class="fas fa-hashtag me-1"></i>Order: #${addr.orderId}</div>` : ''}
              ${addr.source === 'order' ? `<div class="small text-muted"><i class="fas fa-calendar me-1"></i>${new Date(addr.orderDate).toLocaleDateString()}</div>` : ''}
              ${sourceBadge}
            </div>
            <div>
              ${addr.source === 'saved' ? `
                <button class="btn-outline-secondary edit-address" style="padding: 4px 12px; font-size: 0.7rem;" onclick="editAddress(${index})">
                  <i class="fas fa-edit"></i>
                </button>
                <button class="btn-outline-secondary delete-address" style="padding: 4px 12px; font-size: 0.7rem; margin-left: 8px;" onclick="deleteAddress(${index})">
                  <i class="fas fa-trash"></i>
                </button>
              ` : `
                <button class="btn-outline-secondary" style="padding: 4px 12px; font-size: 0.7rem; cursor: default; opacity: 0.6;">
                  <i class="fas fa-lock me-1"></i>From Order
                </button>
              `}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // ================================================================
  // CART COUNT
  // ================================================================
  function loadCartCount() {
    const savedCart = localStorage.getItem('shopygo_cart');
    if (savedCart) {
      const cart = JSON.parse(savedCart);
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      document.getElementById('cartCount').innerText = count;
    }
  }

  // ================================================================
  // TOAST
  // ================================================================
  function showToast(message, isError = false) {
    const existing = document.querySelector('.toast-msg');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.className = 'toast-msg' + (isError ? ' error' : '');
    toast.innerHTML = `<i class="fas ${isError ? 'fa-exclamation-circle' : 'fa-check-circle'} me-2"></i>${message}`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  // ================================================================
  // TOGGLE PASSWORD
  // ================================================================
  function togglePassword(inputId) {
    const input = document.getElementById(inputId);
    const icon = input.parentElement.querySelector('button i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fas fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fas fa-eye';
    }
  }

  // ================================================================
  // SIDEBAR NAVIGATION
  // ================================================================
  const sidebarItems = document.querySelectorAll('.settings-sidebar-item');
  const sections = document.querySelectorAll('.settings-section');

  sidebarItems.forEach(item => {
    item.addEventListener('click', () => {
      const sectionId = item.getAttribute('data-section');
      sidebarItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      sections.forEach(section => section.classList.remove('active'));
      document.getElementById(`${sectionId}-section`).classList.add('active');
    });
  });

  // ================================================================
  // UPDATE PROFILE
  // ================================================================
  document.getElementById('profileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const firstName = document.getElementById('firstName').value.trim();
    const lastName = document.getElementById('lastName').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const dob = document.getElementById('dob').value;
    const bio = document.getElementById('bio').value.trim();

    const name = firstName + (lastName ? ' ' + lastName : '');

    if (!name) {
      showToast('Name is required', true);
      return;
    }

    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ name, phone, dob, bio })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || 'Failed to update profile');
      }

      // Update localStorage
      currentUser.name = name;
      currentUser.phone = phone;
      currentUser.dob = dob;
      currentUser.bio = bio;
      localStorage.setItem('user', JSON.stringify(currentUser));

      // Update avatar
      document.getElementById('avatarLetter').textContent = name.charAt(0).toUpperCase();

      showToast('✅ Profile updated successfully!');

    } catch (error) {
      console.error('Error updating profile:', error);
      showToast('❌ ' + error.message, true);
    }

    btn.disabled = false;
    btn.innerHTML = originalText;
  });

  // ================================================================
  // UPDATE PASSWORD
  // ================================================================
  document.getElementById('securityForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    if (!currentPassword || !newPassword || !confirmPassword) {
      showToast('All fields are required', true);
      return;
    }

    if (newPassword.length < 8) {
      showToast('New password must be at least 8 characters', true);
      return;
    }

    if (newPassword !== confirmPassword) {
      showToast('Passwords do not match', true);
      return;
    }

    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/password`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword, newPassword })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || 'Failed to change password');
      }

      showToast('✅ Password changed successfully!');
      document.getElementById('securityForm').reset();

    } catch (error) {
      console.error('Error changing password:', error);
      showToast('❌ ' + error.message, true);
    }

    btn.disabled = false;
    btn.innerHTML = originalText;
  });

  // ================================================================
  // SAVE NOTIFICATIONS
  // ================================================================
  document.getElementById('saveNotifications').addEventListener('click', async () => {
    const notifications = {
      order: document.getElementById('orderUpdates').checked,
      promo: document.getElementById('promotions').checked,
      newsletter: document.getElementById('newsletter').checked,
      sms: document.getElementById('smsAlerts').checked
    };

    const btn = document.getElementById('saveNotifications');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/notifications`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ notifications })
      });

      if (!response.ok) {
        throw new Error('Failed to save notification settings');
      }

      currentUser.notifications = notifications;
      localStorage.setItem('user', JSON.stringify(currentUser));

      showToast('✅ Notification preferences saved!');

    } catch (error) {
      console.error('Error saving notifications:', error);
      showToast('❌ ' + error.message, true);
    }

    btn.disabled = false;
    btn.innerHTML = originalText;
  });

  // ================================================================
  // SAVE PREFERENCES
  // ================================================================
  document.getElementById('savePreferences').addEventListener('click', async () => {
    const language = document.getElementById('language').value;
    const currency = document.getElementById('currency').value;
    const theme = document.getElementById('darkModeToggle').checked ? 'dark' : 'light';

    const btn = document.getElementById('savePreferences');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/preferences`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ language, currency, theme })
      });

      if (!response.ok) {
        throw new Error('Failed to save preferences');
      }

      currentUser.language = language;
      currentUser.currency = currency;
      currentUser.theme = theme;
      localStorage.setItem('user', JSON.stringify(currentUser));

      if (theme === 'dark') {
        document.body.style.background = '#1e293b';
        document.body.style.color = '#f1f5f9';
      } else {
        document.body.style.background = '#f8fafc';
        document.body.style.color = '#0f172a';
      }

      showToast('✅ Preferences saved!');

    } catch (error) {
      console.error('Error saving preferences:', error);
      showToast('❌ ' + error.message, true);
    }

    btn.disabled = false;
    btn.innerHTML = originalText;
  });

  // ================================================================
  // TWO-FACTOR AUTH
  // ================================================================
  document.getElementById('twoFactorToggle').addEventListener('change', async (e) => {
    const enabled = e.target.checked;

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/2fa`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ enabled })
      });

      if (!response.ok) {
        throw new Error('Failed to update 2FA');
      }

      currentUser.twoFactor = enabled ? 'enabled' : 'disabled';
      localStorage.setItem('user', JSON.stringify(currentUser));

      showToast(enabled ? '✅ Two-factor authentication enabled' : 'Two-factor authentication disabled');

    } catch (error) {
      console.error('Error updating 2FA:', error);
      showToast('❌ ' + error.message, true);
      e.target.checked = !enabled;
    }
  });

  // ================================================================
  // UPLOAD PHOTO
  // ================================================================
  document.getElementById('uploadPhotoBtn').addEventListener('click', () => {
    document.getElementById('photoInput').click();
  });

  document.getElementById('photoInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('photo', file);

    const btn = document.getElementById('uploadPhotoBtn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/photo`, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      });

      if (!response.ok) {
        throw new Error('Failed to upload photo');
      }

      const data = await response.json();
      if (data.success && data.photoUrl) {
        currentUser.photo = data.photoUrl;
        localStorage.setItem('user', JSON.stringify(currentUser));
      }

      showToast('✅ Photo updated successfully!');
      setTimeout(() => window.location.reload(), 1000);

    } catch (error) {
      console.error('Error uploading photo:', error);
      showToast('❌ ' + error.message, true);
    }

    btn.disabled = false;
    btn.innerHTML = originalText;
  });

  // ================================================================
  // ADDRESS FUNCTIONS
  // ================================================================
  document.getElementById('addAddressBtn').addEventListener('click', () => {
    const address = prompt('Enter complete address (Street, City, State, Pincode):');
    if (address && address.trim()) {
      const label = prompt('Enter label (Home, Work, Office, etc.):') || 'Home';
      const phone = prompt('Enter phone number:') || currentUser.phone || '';
      
      const newAddress = { label, address: address.trim(), phone };
      saveAddress(newAddress);
    }
  });

  async function saveAddress(address) {
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/addresses`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(address)
      });

      if (!response.ok) {
        throw new Error('Failed to add address');
      }

      const data = await response.json();
      currentUser.addresses = data.addresses;
      localStorage.setItem('user', JSON.stringify(currentUser));
      
      showToast('✅ Address added successfully!');
      await loadAllAddresses();

    } catch (error) {
      console.error('Error adding address:', error);
      showToast('❌ ' + error.message, true);
    }
  }

  window.editAddress = function(index) {
    // Find the actual saved address (source === 'saved')
    const savedAddresses = allAddresses.filter(a => a.source === 'saved');
    if (index >= savedAddresses.length) {
      showToast('This address cannot be edited (from order)', true);
      return;
    }

    const address = savedAddresses[index];
    const newAddress = prompt('Edit address:', address.address);
    if (newAddress && newAddress.trim()) {
      const label = prompt('Edit label:', address.label) || address.label;
      const phone = prompt('Edit phone:', address.phone) || address.phone;
      
      // Find the index in the actual user.addresses array
      const userAddrIndex = currentUser.addresses.findIndex(a => 
        a.address === address.address && a.label === address.label
      );
      
      if (userAddrIndex !== -1) {
        updateAddress(userAddrIndex, { label, address: newAddress.trim(), phone });
      }
    }
  };

  async function updateAddress(index, address) {
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/addresses/${index}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(address)
      });

      if (!response.ok) {
        throw new Error('Failed to update address');
      }

      const data = await response.json();
      currentUser.addresses = data.addresses;
      localStorage.setItem('user', JSON.stringify(currentUser));
      
      showToast('✅ Address updated successfully!');
      await loadAllAddresses();

    } catch (error) {
      console.error('Error updating address:', error);
      showToast('❌ ' + error.message, true);
    }
  }

  window.deleteAddress = async function(index) {
    // Find the actual saved address (source === 'saved')
    const savedAddresses = allAddresses.filter(a => a.source === 'saved');
    if (index >= savedAddresses.length) {
      showToast('This address cannot be deleted (from order)', true);
      return;
    }

    if (!confirm('Are you sure you want to delete this address?')) return;

    const address = savedAddresses[index];
    const userAddrIndex = currentUser.addresses.findIndex(a => 
      a.address === address.address && a.label === address.label
    );

    if (userAddrIndex === -1) {
      showToast('Address not found', true);
      return;
    }

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}/addresses/${userAddrIndex}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (!response.ok) {
        throw new Error('Failed to delete address');
      }

      const data = await response.json();
      currentUser.addresses = data.addresses;
      localStorage.setItem('user', JSON.stringify(currentUser));
      
      showToast('✅ Address deleted successfully!');
      await loadAllAddresses();

    } catch (error) {
      console.error('Error deleting address:', error);
      showToast('❌ ' + error.message, true);
    }
  };

  // ================================================================
  // DELETE ACCOUNT
  // ================================================================
  document.getElementById('deleteAccountBtn').addEventListener('click', async () => {
    const confirmText = document.getElementById('deleteConfirm').value;
    
    if (confirmText !== 'DELETE') {
      showToast('Please type DELETE to confirm', true);
      return;
    }

    if (!confirm('Are you sure you want to delete your account? This action cannot be undone!')) return;

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${API_URL}/users/${currentUser._id}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (!response.ok) {
        throw new Error('Failed to delete account');
      }

      localStorage.removeItem('token');
      localStorage.removeItem('user');
      showToast('✅ Account deleted successfully');
      setTimeout(() => window.location.href = '/', 2000);

    } catch (error) {
      console.error('Error deleting account:', error);
      showToast('❌ ' + error.message, true);
    }
  });

  // ================================================================
  // INIT
  // ================================================================
  document.addEventListener('DOMContentLoaded', function() {
    console.log('⚙️ User Settings Page Loaded');
    loadUserData();
  });

  // ================================================================
  // GLOBAL FUNCTIONS
  // ================================================================
  window.showToast = showToast;
  window.togglePassword = togglePassword;
  window.editAddress = editAddress;
  window.deleteAddress = deleteAddress;
</script>
</body>
</html>