        </div>
    </div>
</div>

<!-- ===== MAIN CONTENT ===== -->
<div class="container my-4">

    <!-- Loading -->
    <div id="loadingState" class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading product details...</p>
    </div>

    <!-- Error -->
    <div id="errorState" style="display:none;" class="text-center py-5">
        <i class="fas fa-exclamation-circle fa-4x text-danger"></i>
        <h4 class="mt-3">Product not found</h4>
        <p class="text-muted" id="errorMessage">The product you are looking for does not exist.</p>
        <div class="mt-3 d-flex gap-3 justify-content-center flex-wrap">
            <a href="/" class="btn btn-primary rounded-pill px-4">Back to Home</a>
            <button onclick="window.location.reload()" class="btn btn-outline-secondary rounded-pill px-4">Reload</button>
        </div>
    </div>

    <!-- Product Content -->
    <div id="productContent" style="display:none;">
        <div class="row g-4">
            <!-- Images -->
            <div class="col-md-6">
                <img id="mainImage" src="" alt="Product" class="product-img-main">
                <div class="thumbnail-container" id="thumbnailContainer"></div>
            </div>

            <!-- Info -->
            <div class="col-md-6">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbName">Product</li>
                    </ol>
                </nav>

                <h1 class="fw-bold" id="productName">Loading...</h1>
                <p class="text-muted" id="productBrand"></p>

                <div class="mb-2" id="productRating">
                    <span id="stars" style="color:#f5b042;">☆☆☆☆☆</span>
                    <span class="text-muted ms-2" id="reviewCount">(0 reviews)</span>
                </div>

                <div>
                    <span class="price" id="productPrice">₹0</span>
                    <span class="old-price" id="productOldPrice"></span>
                    <span class="discount ms-2" id="productDiscount" style="display:none;"></span>
                </div>

                <div class="mt-2">
                    <span id="stockStatus" class="stock-status">Loading...</span>
                </div>

                <p class="mt-3" id="productDescription">Loading description...</p>

                <!-- Colors -->
                <div id="colorsContainer" style="display:none;">
                    <label class="fw-bold">Colors:</label>
                    <div class="d-flex gap-2 mt-2 flex-wrap" id="colorOptions"></div>
                </div>

                <!-- Sizes -->
                <div id="sizesContainer" style="display:none;">
                    <label class="fw-bold">Sizes:</label>
                    <div class="d-flex gap-2 mt-2 flex-wrap" id="sizeOptions"></div>
                </div>

                <!-- Quantity -->
                <div class="mt-3">
                    <label class="fw-bold">Quantity:</label>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <button class="qty-btn" id="qtyMinus">−</button>
                        <input type="number" id="qtyValue" class="qty-input" value="1" min="1" readonly>
                        <button class="qty-btn" id="qtyPlus">+</button>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-3 mt-4">
                    <button class="btn-add-cart" id="addToCartBtn">
                        <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                    </button>
                    <button class="btn-buy" id="buyNowBtn">
                        <i class="fas fa-bolt me-2"></i> Buy Now
                    </button>
                </div>

                <div class="mt-3 small text-muted">
                    <i class="fas fa-truck me-2"></i> Free delivery on orders above ₹999
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <div class="mt-5">
            <h4 class="fw-bold mb-4">You may also like</h4>
            <div class="row g-4" id="relatedProducts">
                <div class="col-12 text-center">
                    <div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== FOOTER ===== -->
