<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ================================================================
    // CONFIGURATION
    // ================================================================
    const API_URL = 'http://localhost:5000/api';
    
    const urlParams = new URLSearchParams(window.location.search);
    const productId = urlParams.get('id');

    console.log('📌 Product ID from URL:', productId);

    // ================================================================
    // CHECK LOGIN STATUS
    // ================================================================
    function isLoggedIn() {
        const token = localStorage.getItem('token');
        if (token && token !== 'null' && token !== 'undefined' && token !== '') {
            return true;
        }
        return false;
    }

    // ================================================================
    // LOGIN POPUP
    // ================================================================
    let pendingProductId = null;
    let pendingAction = null;
    let pendingRedirect = null;

    function showLoginPopup(productId, action, redirect) {
        pendingProductId = productId;
        pendingAction = action || 'addtocart';
        pendingRedirect = redirect || null;
        
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeLoginPopup() {
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.remove('show');
            document.body.style.overflow = '';
        }
        pendingProductId = null;
        pendingAction = null;
        pendingRedirect = null;
    }

    document.getElementById('loginPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeLoginPopup();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeLoginPopup();
        }
    });

    // ================================================================
    // CART ICON CLICK
    // ================================================================
    function handleCartClick(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        
        if (!isLoggedIn()) {
            showLoginPopup(null, 'redirect', '/cart');
            return false;
        }
        
        window.location.href = '/cart';
        return false;
    }

    // ================================================================
    // STATE
    // ================================================================
    let currentProduct = null;
    let currentQuantity = 1;
    let selectedSize = null;
    let selectedColor = null;

    // ================================================================
    // CART
    // ================================================================
    function getCart() {
        return JSON.parse(localStorage.getItem('cart')) || [];
    }

    function saveCart(cart) {
        localStorage.setItem('cart', JSON.stringify(cart));
        updateCartCount();
    }

    function updateCartCount() {
        const cart = getCart();
        const total = cart.reduce((sum, item) => sum + item.quantity, 0);
        const badge = document.getElementById('cartCount');
        if (badge) badge.textContent = total;
    }

    // ================================================================
    // TOAST
    // ================================================================
    function showToast(message, type = 'info') {
        const existing = document.querySelector('.toast-msg');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = `toast-msg ${type}`;
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
            if (toast.parentElement) {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s';
                setTimeout(() => toast.remove(), 300);
            }
        }, 3000);
    }

    // ================================================================
    // HELPERS
    // ================================================================
    function formatPrice(p) {
        if (!p) return '₹0';
        return `₹${Number(p).toFixed(2)}`;
    }

    function getStars(r) {
        if (!r) return '☆☆☆☆☆';
        let s = '';
        for (let i = 0; i < Math.floor(r); i++) s += '★';
        if (r % 1 >= 0.5) s += '½';
        for (let i = s.length; i < 5; i++) s += '☆';
        return s;
    }

    function getIcon(cat) {
        const map = {
            'clothing': 'fa-tshirt',
            'electronics': 'fa-laptop',
            'jewellery': 'fa-gem',
            'footwear': 'fa-shoe-prints',
            'accessories': 'fa-glasses',
            'beauty': 'fa-mask',
            'home': 'fa-couch',
            'sports': 'fa-running',
            'books': 'fa-book',
            'toys': 'fa-robot',
            'default': 'fa-folder'
        };
        const l = cat?.toLowerCase() || '';
        for (const [k, v] of Object.entries(map)) {
            if (l.includes(k)) return v;
        }
        return map.default;
    }

    // ================================================================
    // API CALL
    // ================================================================
    async function apiCall(endpoint) {
        try {
            const url = `${API_URL}${endpoint}`;
            console.log('📡 Fetching:', url);
            const res = await fetch(url);
            
            console.log('📊 Response Status:', res.status);
            
            if (!res.ok) {
                const text = await res.text();
                console.error('❌ Response Error:', text);
                throw new Error(`HTTP ${res.status}: ${res.statusText}`);
            }
            
            const data = await res.json();
            console.log('✅ API Response:', data);
            return data;
        } catch (error) {
            console.error('❌ API Error:', error);
            throw error;
        }
    }

    // ================================================================
    // CHECK PENDING ACTION AFTER LOGIN
    // ================================================================
    function checkPendingAction() {
        if (pendingProductId && pendingAction) {
            const productId = pendingProductId;
            const action = pendingAction;
            const redirect = pendingRedirect;
            
            pendingProductId = null;
            pendingAction = null;
            pendingRedirect = null;
            
            if (action === 'addtocart') {
                let cart = getCart();
                const existing = cart.find(i => i.productId === productId);
                if (existing) {
                    existing.quantity += currentQuantity;
                } else {
                    cart.push({
                        productId: productId,
                        quantity: currentQuantity,
                        size: selectedSize || null,
                        color: selectedColor || null
                    });
                }
                saveCart(cart);
                showToast('✅ Added to cart!', 'success');
            } else if (action === 'buynow') {
                let cart = [{
                    productId: productId,
                    quantity: currentQuantity,
                    size: selectedSize || null,
                    color: selectedColor || null
                }];
                saveCart(cart);
                window.location.href = '/checkout';
            } else if (action === 'redirect' && redirect) {
                window.location.href = redirect;
            }
        }
    }

    // ================================================================
    // LOAD PRODUCT
    // ================================================================
    async function loadProduct() {
        const loadingState = document.getElementById('loadingState');
        const errorState = document.getElementById('errorState');
        const productContent = document.getElementById('productContent');

        if (!productId) {
            loadingState.style.display = 'none';
            errorState.style.display = 'block';
            document.getElementById('errorMessage').textContent = 'No product ID provided.';
            return;
        }

        try {
            const product = await apiCall(`/products/${productId}`);
            
            if (!product || product.error) {
                loadingState.style.display = 'none';
                errorState.style.display = 'block';
                document.getElementById('errorMessage').textContent = `Product with ID "${productId}" not found.`;
                return;
            }

            currentProduct = product;
            console.log('✅ Product found:', product.name);

            loadingState.style.display = 'none';
            productContent.style.display = 'block';
            errorState.style.display = 'none';

            document.title = `${product.name} - ShopyGo`;
            document.getElementById('breadcrumbName').textContent = product.name;

            // ===== MAIN IMAGE =====
            const mainImg = document.getElementById('mainImage');
            if (product.mainImage && product.mainImage.startsWith('data:image')) {
                mainImg.src = product.mainImage;
                mainImg.style.display = 'block';
            } else if (product.mainImage) {
                mainImg.src = product.mainImage;
                mainImg.style.display = 'block';
            } else {
                mainImg.style.display = 'none';
                mainImg.alt = 'No image available';
            }

            // ===== THUMBNAILS =====
            const thumbContainer = document.getElementById('thumbnailContainer');
            thumbContainer.innerHTML = '';
            
            // Get all images
            let allImages = [];
            if (product.mainImage) allImages.push(product.mainImage);
            if (product.subImages && Array.isArray(product.subImages)) {
                allImages = allImages.concat(product.subImages);
            }
            
            // Remove duplicates
            allImages = [...new Set(allImages)];
            
            console.log('📸 Images found:', allImages.length);

            if (allImages.length > 0) {
                allImages.forEach((img, index) => {
                    const thumb = document.createElement('div');
                    thumb.className = `thumbnail ${index === 0 ? 'active' : ''}`;
                    thumb.innerHTML = `<img src="${img}" class="thumbnail-img" alt="Thumbnail" onerror="this.parentElement.innerHTML='<div class=\\'thumbnail-placeholder\\'><i class=\\'fas ${getIcon(product.category)}\\'></i></div>'">`;
                    thumb.onclick = function() {
                        document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
                        this.classList.add('active');
                        const mainImg = document.getElementById('mainImage');
                        if (mainImg) {
                            mainImg.src = img;
                            mainImg.style.display = 'block';
                        }
                    };
                    thumbContainer.appendChild(thumb);
                });
            } else {
                // No images - show placeholder
                const thumb = document.createElement('div');
                thumb.className = 'thumbnail active';
                thumb.innerHTML = `<div class="thumbnail-placeholder"><i class="fas ${getIcon(product.category)}"></i></div>`;
                thumbContainer.appendChild(thumb);
            }

            // ===== BASIC INFO =====
            document.getElementById('productName').textContent = product.name || 'Unnamed Product';
            document.getElementById('productBrand').textContent = product.brand || '';
            document.getElementById('productDescription').textContent =
                product.fullDesc || product.shortDesc || product.description || 'No description available.';

            // ===== RATING =====
            const rating = product.rating || 0;
            const reviews = product.numReviews || 0;
            document.getElementById('stars').textContent = getStars(rating);
            document.getElementById('reviewCount').textContent = `(${reviews} reviews)`;

            // ===== PRICE =====
            const price = Number(product.price) || 0;
            const sale = product.salePrice ? Number(product.salePrice) : null;

            if (sale && sale < price) {
                document.getElementById('productPrice').textContent = formatPrice(sale);
                document.getElementById('productOldPrice').textContent = formatPrice(price);
                const discount = Math.round(((price - sale) / price) * 100);
                if (discount) {
                    document.getElementById('productDiscount').style.display = 'inline-block';
                    document.getElementById('productDiscount').textContent = `${discount}% OFF`;
                }
            } else {
                document.getElementById('productPrice').textContent = formatPrice(price);
                document.getElementById('productOldPrice').textContent = '';
                document.getElementById('productDiscount').style.display = 'none';
            }

            // ===== STOCK =====
            const stockEl = document.getElementById('stockStatus');
            if (product.stock > 10) {
                stockEl.textContent = '✅ In Stock';
                stockEl.className = 'stock-status in-stock';
            } else if (product.stock > 0) {
                stockEl.textContent = `⚠️ Only ${product.stock} left`;
                stockEl.className = 'stock-status low-stock';
            } else {
                stockEl.textContent = '❌ Out of Stock';
                stockEl.className = 'stock-status out-of-stock';
                document.getElementById('addToCartBtn').disabled = true;
                document.getElementById('buyNowBtn').disabled = true;
            }

            // ===== COLORS =====
            const colorsContainer = document.getElementById('colorsContainer');
            const colorOptions = document.getElementById('colorOptions');
            if (product.colors && product.colors.length > 0) {
                colorsContainer.style.display = 'block';
                colorOptions.innerHTML = '';
                product.colors.forEach((c, index) => {
                    const colorBtn = document.createElement('div');
                    colorBtn.className = `color-option ${index === 0 ? 'active' : ''}`;
                    colorBtn.style.background = c.hex || '#2563eb';
                    colorBtn.title = c.name || 'Color';
                    colorBtn.dataset.color = c.name || c.hex;
                    colorBtn.onclick = function() {
                        document.querySelectorAll('.color-option').forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                        selectedColor = this.dataset.color;
                    };
                    colorOptions.appendChild(colorBtn);
                });
                selectedColor = product.colors[0]?.name || product.colors[0]?.hex;
            } else {
                colorsContainer.style.display = 'none';
            }

            // ===== SIZES =====
            const sizesContainer = document.getElementById('sizesContainer');
            const sizeOptions = document.getElementById('sizeOptions');
            if (product.sizes && product.sizes.length > 0) {
                sizesContainer.style.display = 'block';
                sizeOptions.innerHTML = '';
                product.sizes.forEach((size, index) => {
                    const btn = document.createElement('button');
                    btn.className = `size-option ${index === 0 ? 'active' : ''}`;
                    btn.textContent = size;
                    btn.dataset.size = size;
                    btn.onclick = function() {
                        document.querySelectorAll('.size-option').forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                        selectedSize = this.dataset.size;
                    };
                    sizeOptions.appendChild(btn);
                });
                selectedSize = product.sizes[0];
            } else {
                sizesContainer.style.display = 'none';
            }

            // ===== RELATED PRODUCTS =====
            await loadRelatedProducts(product.category);

            console.log('✅ Product loaded successfully!');

        } catch (error) {
            console.error('❌ Error:', error);
            loadingState.style.display = 'none';
            errorState.style.display = 'block';
            document.getElementById('errorMessage').textContent = error.message || 'Product not found.';
        }
    }

    // ================================================================
    // LOAD RELATED PRODUCTS
    // ================================================================
    async function loadRelatedProducts(category) {
        try {
            const data = await apiCall(`/products?category=${category}&limit=4`);
            
            let products = [];
            if (Array.isArray(data)) {
                products = data;
            } else if (data.products && Array.isArray(data.products)) {
                products = data.products;
            }
            
            const container = document.getElementById('relatedProducts');

            if (!products || products.length === 0) {
                container.innerHTML = `<div class="col-12 text-center text-muted">No related products</div>`;
                return;
            }

            container.innerHTML = products.map(p => `
                <div class="col-6 col-md-3">
                    <a href="/product-detail?id=${p._id}" class="related-card">
                        <img src="${p.mainImage || 'https://via.placeholder.com/200x200'}" 
                             class="related-img" alt="${p.name}" 
                             onerror="this.parentElement.innerHTML='<div class=\\'related-img\\'><i class=\\'fas ${getIcon(p.category)}\\' style=\\'font-size:3rem;color:#2563eb;\\'></i></div>'">
                        <div class="related-title">${p.name}</div>
                        <div class="fw-bold text-primary">${formatPrice(p.salePrice || p.price)}</div>
                    </a>
                </div>
            `).join('');

        } catch (error) {
            console.error('Error loading related products:', error);
            document.getElementById('relatedProducts').innerHTML =
                `<div class="col-12 text-center text-muted">No related products</div>`;
        }
    }

    // ================================================================
    // QUANTITY
    // ================================================================
    document.getElementById('qtyMinus').addEventListener('click', () => {
        if (currentQuantity > 1) {
            currentQuantity--;
            document.getElementById('qtyValue').value = currentQuantity;
        }
    });

    document.getElementById('qtyPlus').addEventListener('click', () => {
        if (currentProduct && currentProduct.stock && currentQuantity < currentProduct.stock) {
            currentQuantity++;
            document.getElementById('qtyValue').value = currentQuantity;
        } else if (!currentProduct || currentQuantity < 10) {
            currentQuantity++;
            document.getElementById('qtyValue').value = currentQuantity;
        } else {
            showToast('Maximum quantity reached', 'error');
        }
    });

    // ================================================================
    // ADD TO CART
    // ================================================================
    document.getElementById('addToCartBtn').addEventListener('click', function() {
        if (!currentProduct) return;

        if (currentProduct.stock === 0) {
            showToast('❌ Out of stock!', 'error');
            return;
        }

        if (!isLoggedIn()) {
            showLoginPopup(currentProduct._id, 'addtocart');
            return;
        }

        let cart = getCart();
        const existing = cart.find(item => item.productId === currentProduct._id);

        if (existing) {
            existing.quantity += currentQuantity;
        } else {
            cart.push({
                productId: currentProduct._id,
                quantity: currentQuantity,
                size: selectedSize || null,
                color: selectedColor || null
            });
        }

        saveCart(cart);
        showToast(`✅ ${currentQuantity} item(s) added to cart!`, 'success');

        currentQuantity = 1;
        document.getElementById('qtyValue').value = currentQuantity;
    });

    // ================================================================
    // BUY NOW
    // ================================================================
    document.getElementById('buyNowBtn').addEventListener('click', function() {
        if (!currentProduct) return;

        if (currentProduct.stock === 0) {
            showToast('❌ Out of stock!', 'error');
            return;
        }

        if (!isLoggedIn()) {
            showLoginPopup(currentProduct._id, 'buynow');
            return;
        }

        let cart = [{
            productId: currentProduct._id,
            quantity: currentQuantity,
            size: selectedSize || null,
            color: selectedColor || null
        }];
        saveCart(cart);
        window.location.href = '/checkout';
    });

    // ================================================================
    // INIT
    // ================================================================
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Product detail page loaded!');
        updateCartCount();
        loadProduct();
        checkPendingAction();
    });

    window.handleCartClick = handleCartClick;
    window.closeLoginPopup = closeLoginPopup;
</script>
</body>
</html>