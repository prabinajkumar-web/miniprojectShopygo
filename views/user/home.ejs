<!-- Debug badge -->
<div class="debug-badge" id="debugBadge" onclick="showDebugInfo()">
    🔍 Debug
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const API_URL = 'http://localhost:5000/api';
    let currentCategoryId = null;
    let pendingProductId = null;
    let pendingAction = null;
    let pendingRedirect = null;
    let allProducts = [];
    let currentSearchTerm = '';

    // ================================================================
    // DEBUG FUNCTION
    // ================================================================
    function showDebugInfo() {
        const token = localStorage.getItem('token');
        const user = localStorage.getItem('user');
        console.log('🔍 DEBUG INFO:');
        console.log('Token:', token);
        console.log('User:', user);
        console.log('Is Logged In:', isLoggedIn());
        console.log('All Products Count:', allProducts.length);
        alert(`🔍 Debug Info:\n\nLogged In: ${isLoggedIn()}\nToken: ${token ? '✅ Present' : '❌ Missing'}\nUser: ${user ? JSON.stringify(JSON.parse(user)) : '❌ Missing'}\nProducts Loaded: ${allProducts.length}`);
        updateNavbar();
    }

    // ================================================================
    // CHECK LOGIN STATUS
    // ================================================================
    function isLoggedIn() {
        try {
            const token = localStorage.getItem('token');
            if (token && token !== 'null' && token !== 'undefined' && token.trim() !== '') {
                const user = localStorage.getItem('user');
                if (user && user !== 'null' && user !== 'undefined') {
                    return true;
                }
            }
            return false;
        } catch (e) {
            console.error('Error checking login status:', e);
            return false;
        }
    }

    // ================================================================
    // LOGIN POPUP
    // ================================================================
    function showLoginPopup(productId, action, redirect) {
        pendingProductId = productId;
        pendingAction = action || 'addtocart';
        pendingRedirect = redirect || null;
        
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeLoginPopup() {
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.remove('show');
            document.body.style.overflow = '';
        }
        pendingProductId = null;
        pendingAction = null;
        pendingRedirect = null;
    }

    document.getElementById('loginPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeLoginPopup();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeLoginPopup();
        }
    });

    // ================================================================
    // SEARCH FUNCTIONALITY
    // ================================================================
    function performSearch() {
        const query = document.getElementById('globalSearchInput').value.trim();
        if (!query) {
            showToast('Please enter a search term', 'info');
            return;
        }
        window.location.href = `/search?q=${encodeURIComponent(query)}`;
    }

    function clearSearch() {
        document.getElementById('searchResultsSection').style.display = 'none';
        document.getElementById('trendingSection').style.display = 'block';
        document.getElementById('newArrivalsSection').style.display = 'block';
        document.getElementById('globalSearchInput').value = '';
        currentSearchTerm = '';
        const url = new URL(window.location);
        url.searchParams.delete('search');
        window.history.pushState({}, '', url);
    }

    async function loadSearchResults() {
        const params = new URLSearchParams(window.location.search);
        const search = params.get('search');
        if (!search) {
            document.getElementById('searchResultsSection').style.display = 'none';
            document.getElementById('trendingSection').style.display = 'block';
            document.getElementById('newArrivalsSection').style.display = 'block';
            return;
        }
        currentSearchTerm = search;
        document.getElementById('globalSearchInput').value = search;
        document.getElementById('searchResultsSection').style.display = 'block';
        document.getElementById('trendingSection').style.display = 'none';
        document.getElementById('newArrivalsSection').style.display = 'none';
        document.getElementById('searchTermDisplay').textContent = search;

        try {
            const data = await apiCall(`/products?search=${encodeURIComponent(search)}&limit=50`);
            let products = [];
            if (data.products && Array.isArray(data.products)) {
                products = data.products;
            } else if (Array.isArray(data)) {
                products = data;
            }
            allProducts = products;
            document.getElementById('searchResultCount').textContent = `(${products.length} found)`;
            renderSearchResults(products);
        } catch (error) {
            console.error('❌ Search error:', error);
            document.getElementById('searchResultsGrid').innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="fas fa-exclamation-circle fa-3x text-danger"></i>
                    <h5 class="mt-3">Error loading results</h5>
                    <p class="text-muted">${error.message}</p>
                </div>
            `;
            document.getElementById('searchResultCount').textContent = '(Error)';
        }
    }

    function renderSearchResults(products) {
        const grid = document.getElementById('searchResultsGrid');
        if (!products || products.length === 0) {
            grid.innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="fas fa-search fa-3x text-muted"></i>
                    <h5 class="mt-3">No products found</h5>
                    <p class="text-muted">Try different keywords or browse our categories</p>
                    <a href="/" class="btn btn-outline-primary-blue mt-2">
                        <i class="fas fa-home me-2"></i> Back to Home
                    </a>
                </div>
            `;
            return;
        }
        grid.innerHTML = products.map(product => {
            const price = Number(product.price) || 0;
            const sale = product.salePrice ? Number(product.salePrice) : null;
            const displayPrice = sale && sale < price ? sale : price;
            const showOriginal = sale && sale < price;
            const discount = showOriginal ? Math.round(((price - sale) / price) * 100) : null;
            const img = product.mainImage || product.image || 'https://via.placeholder.com/300x300';
            const rating = product.rating || 4.5;
            const ratingCount = product.ratingCount || 0;
            return `
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="/product-detail?id=${product._id}" class="product-link">
                        <div class="product-card">
                            <div class="product-img">
                                <img src="${img}" alt="${product.name}" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\\'fas ${getIcon(product.category)}\\'></i>'">
                            </div>
                            <div class="p-3">
                                <h6 class="fw-bold" style="display:-webkit-box; display:box; -webkit-line-clamp:2; line-clamp:2; -webkit-box-orient:vertical; box-orient:vertical; overflow:hidden; height:44px;">${product.name || 'Product'}</h6>
                                <div class="rating">${getStars(rating)} <span class="rating-count">(${ratingCount || Math.floor(Math.random() * 50) + 10})</span></div>
                                <div class="d-flex align-items-center flex-wrap">
                                    <span class="current-price">${formatPrice(displayPrice)}</span>
                                    ${showOriginal ? `<span class="original-price">${formatPrice(price)}</span>` : ''}
                                    ${discount ? `<span class="sale-badge">-${discount}%</span>` : ''}
                                </div>
                                <button class="btn btn-primary-blue w-100 mt-2" style="font-size:0.8rem;padding:6px 12px;" onclick="addToCart(event, '${product._id}')">
                                    <i class="fas fa-shopping-cart"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </a>
                </div>
            `;
        }).join('');
    }

    // ================================================================
    // CART ICON CLICK
    // ================================================================
    function handleCartClick(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        if (!isLoggedIn()) {
            showLoginPopup(null, 'redirect', '/cart');
            return false;
        }
        window.location.href = '/cart';
        return false;
    }

    // ================================================================
    // SUB CATEGORY ICON MAPPING
    // ================================================================
    function getSubcategoryIcon(subcategoryName) {
        const icons = {
            "Men's clothing": 'fa-male',
            "Women's Clothing": 'fa-female',
            "Kids' Clothing": 'fa-child',
            "Bridal Sets": 'fa-ring',
            "Earrings": 'fa-gem',
            "Bangles": 'fa-hand-sparkles',
            "Men's Footwear": 'fa-shoe-prints',
            "Women's Footwear": 'fa-shoe-prints',
            "Kids' Footwear": 'fa-shoe-prints',
            "Watches": 'fa-clock',
            "Bags": 'fa-bag-shopping',
            "Hair Accessories": 'fa-paintbrush'
        };
        return icons[subcategoryName] || 'fa-tag';
    }

    // ================================================================
    // TOAST
    // ================================================================
    function showToast(message, type = 'info') {
        let container = document.getElementById('toastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            document.body.appendChild(container);
        }
        const bgColor = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white ${bgColor} border-0 show`;
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
        `;
        container.appendChild(toast);
        setTimeout(() => {
            if (toast.parentElement) {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }
        }, 3000);
    }

    // ================================================================
    // CART
    // ================================================================
    function getCart() {
        return JSON.parse(localStorage.getItem('cart')) || [];
    }

    function saveCart(cart) {
        localStorage.setItem('cart', JSON.stringify(cart));
        updateCartCount();
    }

    function updateCartCount() {
        const cart = getCart();
        const total = cart.reduce((sum, item) => sum + item.quantity, 0);
        const badge = document.getElementById('cartCount');
        if (badge) {
            badge.textContent = total;
            badge.style.display = total > 0 ? 'inline-block' : 'none';
        }
    }

    // ================================================================
    // ADD TO CART
    // ================================================================
    function addToCart(event, productId) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        if (!isLoggedIn()) {
            showLoginPopup(productId, 'addtocart');
            return false;
        }
        let cart = getCart();
        const existing = cart.find(item => item.productId === productId);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ productId, quantity: 1 });
        }
        saveCart(cart);
        showToast('✅ Added to cart!', 'success');
        return false;
    }

    // ================================================================
    // CHECK PENDING ACTION
    // ================================================================
    function checkPendingAction() {
        if (pendingProductId && pendingAction) {
            const productId = pendingProductId;
            const action = pendingAction;
            const redirect = pendingRedirect;
            pendingProductId = null;
            pendingAction = null;
            pendingRedirect = null;
            if (action === 'addtocart') {
                let cart = getCart();
                const existing = cart.find(item => item.productId === productId);
                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({ productId, quantity: 1 });
                }
                saveCart(cart);
                showToast('✅ Added to cart!', 'success');
            } else if (action === 'redirect' && redirect) {
                window.location.href = redirect;
            }
        }
    }

    // ================================================================
    // API
    // ================================================================
    async function apiCall(endpoint) {
        try {
            const url = `${API_URL}${endpoint}`;
            console.log('📡 Fetching:', url);
            const res = await fetch(url);
            console.log('📊 Response Status:', res.status);
            if (!res.ok) {
                throw new Error(`HTTP ${res.status}: ${res.statusText}`);
            }
            const data = await res.json();
            console.log('✅ API Response:', data);
            return data;
        } catch (error) {
            console.error('❌ API Error:', error);
            throw error;
        }
    }

    // ================================================================
    // HELPERS
    // ================================================================
    function formatPrice(p) { return `₹${Number(p).toFixed(2)}`; }
    
    function getStars(r) {
        if (!r) return '☆☆☆☆☆';
        let s = '';
        const full = Math.floor(r);
        const half = r % 1 >= 0.5;
        for (let i = 0; i < full; i++) s += '★';
        if (half) s += '½';
        for (let i = s.length; i < 5; i++) s += '☆';
        return s;
    }
    
    function getIcon(cat) {
        const map = {
            'clothing': 'fa-tshirt', 'fashion': 'fa-tshirt',
            'electronics': 'fa-laptop', 'mobile': 'fa-mobile-alt',
            'jewellery': 'fa-gem', 'jewelry': 'fa-gem',
            'footwear': 'fa-shoe-prints', 'shoes': 'fa-shoe-prints',
            'accessories': 'fa-glasses', 'watch': 'fa-clock', 'watches': 'fa-clock',
            'beauty': 'fa-mask', 'home': 'fa-couch', 'furniture': 'fa-couch',
            'sports': 'fa-running', 'books': 'fa-book',
            'toys': 'fa-robot', 'gaming': 'fa-gamepad',
            'default': 'fa-folder'
        };
        const l = cat?.toLowerCase() || '';
        for (const [k, v] of Object.entries(map)) {
            if (l.includes(k)) return v;
        }
        return map.default;
    }

    // ================================================================
    // LOAD CATEGORIES
    // ================================================================
    async function loadCategories() {
        try {
            const cats = await apiCall('/categories');
            const container = document.getElementById('categoriesList');
            if (!cats || cats.length === 0) {
                container.innerHTML = `<div class="col-12 text-center text-muted">No categories</div>`;
                return;
            }
            container.innerHTML = cats.map(cat => {
                const subCount = cat.subcategories ? cat.subcategories.length : 0;
                return `
                    <div class="col-6 col-md-3">
                        <div class="category-card" onclick="openModal('${cat._id}')">
                            ${cat.image ? 
                                `<img src="${cat.image}" class="category-image" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'category-image-placeholder\\'><i class=\\'fas ${getIcon(cat.name)}\\'></i></div>'">` :
                                `<div class="category-image-placeholder"><i class="fas ${getIcon(cat.name)}"></i></div>`
                            }
                            ${subCount > 0 ? `<span class="subcount-badge">${subCount}</span>` : ''}
                            <div class="category-content">
                                <h5 class="fw-bold">${cat.name}</h5>
                                ${subCount > 0 ? `<small class="text-muted">${subCount} subcategories</small>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            console.log(`✅ Loaded ${cats.length} categories`);
        } catch (e) {
            console.error('❌ Error loading categories:', e);
            document.getElementById('categoriesList').innerHTML = `
                <div class="col-12 text-center text-danger">
                    <i class="fas fa-exclamation-circle fa-2x"></i>
                    <p class="mt-2">Failed to load categories: ${e.message}</p>
                </div>
            `;
        }
    }

    // ================================================================
    // OPEN MODAL
    // ================================================================
    async function openModal(categoryId) {
        try {
            console.log('📂 Opening modal for category:', categoryId);
            const cats = await apiCall('/categories');
            const cat = cats.find(c => c._id === categoryId);
            if (!cat) {
                showToast('Category not found', 'error');
                return;
            }
            currentCategoryId = categoryId;
            const subs = cat.subcategories || [];
            const modalName = document.getElementById('modalCategoryName');
            const modalCount = document.getElementById('modalSubcategoryCount');
            const browseBtn = document.getElementById('browseAllBtn');
            if (modalName) modalName.textContent = cat.name;
            if (modalCount) modalCount.textContent = `${subs.length} subcategories`;
            if (browseBtn) browseBtn.href = `/shop?category=${categoryId}`;
            const container = document.getElementById('modalSubcategories');
            if (!container) {
                console.error('❌ modalSubcategories element not found');
                showToast('Modal error - please refresh', 'error');
                return;
            }
            if (subs.length === 0) {
                container.innerHTML = `
                    <div class="col-12 text-center text-muted py-4">
                        <i class="fas fa-folder-open fa-3x mb-3"></i>
                        <p>No subcategories available</p>
                        <a href="/shop?category=${cat._id}" class="btn btn-primary-blue rounded-pill mt-2">
                            <i class="fas fa-store"></i> Browse All Products
                        </a>
                    </div>
                `;
            } else {
                container.innerHTML = subs.map(sub => {
                    const iconClass = getSubcategoryIcon(sub.name);
                    return `
                        <div class="col-md-4 col-sm-6">
                            <div class="subcategory-modal-card" onclick="window.location.href='/shop?subcategory=${sub._id}'">
                                ${sub.image ? 
                                    `<img src="${sub.image}" class="sub-img" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'sub-img-placeholder\\'><i class=\\'fas ${iconClass}\\'></i></div><div class=\\'sub-content\\'><h6 class=\\'fw-bold\\'>${sub.name}</h6>${sub.description ? `<p class=\\'sub-desc\\'>${sub.description}</p>` : ''}</div>'">` :
                                    `<div class="sub-img-placeholder"><i class="fas ${iconClass}"></i></div>`
                                }
                                <div class="sub-content">
                                    <h6 class="fw-bold">${sub.name}</h6>
                                    ${sub.description ? `<p class="sub-desc">${sub.description}</p>` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
            const modalElement = document.getElementById('subcategoryModal');
            if (modalElement) {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            } else {
                console.error('❌ Modal element not found');
                showToast('Modal not found', 'error');
            }
        } catch (e) {
            console.error('❌ Error loading subcategories:', e);
            showToast('Error loading subcategories: ' + e.message, 'error');
        }
    }

    // ================================================================
    // LOAD PRODUCTS
    // ================================================================
    async function loadProducts() {
        try {
            console.log('🔄 Loading products...');
            const data = await apiCall('/products?limit=16');
            let products = [];
            if (data.products && Array.isArray(data.products)) {
                products = data.products;
            } else if (Array.isArray(data)) {
                products = data;
            } else {
                products = [];
            }
            allProducts = products;
            console.log(`📦 Total products: ${products.length}`);
            const trending = products.slice(0, 8);
            const newArrivals = products.slice(8, 16);
            const render = (p) => {
                if (!p || p.length === 0) {
                    return '<div class="col-12 text-center text-muted">No products available</div>';
                }
                return p.map(product => {
                    const price = Number(product.price) || 0;
                    const sale = product.salePrice ? Number(product.salePrice) : null;
                    const display = sale && sale < price ? sale : price;
                    const showOriginal = sale && sale < price;
                    const discount = showOriginal ? Math.round(((price - sale) / price) * 100) : null;
                    const img = product.mainImage || product.image || 'https://via.placeholder.com/300x300';
                    const rating = product.rating || 4.5;
                    const ratingCount = product.ratingCount || 0;
                    return `
                        <div class="col-6 col-md-3">
                            <a href="/product-detail?id=${product._id}" class="product-link">
                                <div class="product-card">
                                    <div class="product-img">
                                        <img src="${img}" alt="${product.name || 'Product'}" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\\'fas ${getIcon(product.category)}\\'></i>'">
                                    </div>
                                    <div class="p-3">
                                        <h6 class="fw-bold" style="display:-webkit-box; display:box; -webkit-line-clamp:2; line-clamp:2; -webkit-box-orient:vertical; box-orient:vertical; overflow:hidden; height:44px;">${product.name || 'Product'}</h6>
                                        <div class="rating">${getStars(rating)} <span class="rating-count">(${ratingCount || Math.floor(Math.random() * 50) + 10})</span></div>
                                        <div class="d-flex align-items-center flex-wrap">
                                            <span class="current-price">${formatPrice(display)}</span>
                                            ${showOriginal ? `<span class="original-price">${formatPrice(price)}</span>` : ''}
                                            ${discount ? `<span class="sale-badge">-${discount}%</span>` : ''}
                                        </div>
                                        <button class="btn btn-primary-blue w-100 mt-2" style="font-size:0.8rem;padding:6px 12px;" onclick="addToCart(event, '${product._id}')">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </button>
                                    </div>
                                </div>
                            </a>
                        </div>
                    `;
                }).join('');
            };
            document.getElementById('trendingProducts').innerHTML = render(trending) || '<div class="col-12 text-center text-muted">No products</div>';
            document.getElementById('newArrivals').innerHTML = render(newArrivals) || '<div class="col-12 text-center text-muted">No products</div>';
            console.log('✅ Products rendered successfully!');
        } catch (e) {
            console.error('❌ Error loading products:', e);
            document.getElementById('trendingProducts').innerHTML = `
                <div class="col-12 text-center text-danger">
                    <i class="fas fa-exclamation-circle fa-2x"></i>
                    <p class="mt-2">Failed to load products: ${e.message}</p>
                    <button class="btn btn-primary btn-sm" onclick="loadProducts()">Retry</button>
                </div>
            `;
            document.getElementById('newArrivals').innerHTML = `
                <div class="col-12 text-center text-muted">No products available</div>
            `;
        }
    }

    // ================================================================
    // AUTH - FIXED: profile name redirects to /profile, logout uses confirm
    // ================================================================
    function updateNavbar() {
        const dropdown = document.getElementById('authDropdown');
        const isLoggedInStatus = isLoggedIn();
        console.log('🔄 Updating navbar, logged in:', isLoggedInStatus);
        if (isLoggedInStatus) {
            try {
                const user = JSON.parse(localStorage.getItem('user') || '{}');
                const userName = user.name || user.username || 'My Account';
                dropdown.innerHTML = `
                    <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>${userName}</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                `;
                console.log('✅ Logout option added to dropdown');
            } catch (e) {
                console.error('Error parsing user data:', e);
                dropdown.innerHTML = `
                    <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>My Account</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                `;
            }
        } else {
            dropdown.innerHTML = `
                <li><a class="dropdown-item" href="/login"><i class="fas fa-sign-in-alt me-2"></i>Login / Signup</a></li>
                <li><a class="dropdown-item" href="/register"><i class="fas fa-user-plus me-2"></i>Create Account</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
            `;
        }
    }

    function logout() {
        if (confirm('Are you sure you want to logout?')) {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            localStorage.removeItem('cart');
            showToast('✅ Logged out successfully!', 'success');
            setTimeout(() => {
                window.location.href = '/';
            }, 500);
        }
    }

    // ================================================================
    // TEST: Set a dummy login for testing
    // ================================================================
    function setTestLogin() {
        localStorage.setItem('token', 'test-token-12345');
        localStorage.setItem('user', JSON.stringify({ name: 'Test User', email: 'test@example.com' }));
        updateNavbar();
        showToast('✅ Test login activated!', 'success');
        console.log('🧪 Test login activated');
    }

    // ================================================================
    // INIT
    // ================================================================
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 ShopyGo Home page loaded!');
        updateCartCount();
        updateNavbar();
        loadCategories();
        loadProducts();
        checkPendingAction();
        loadSearchResults();
        
        document.getElementById('globalSearchBtn').addEventListener('click', performSearch);
        document.getElementById('globalSearchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                performSearch();
            }
        });
        
        setTimeout(() => {
            console.log('📊 Final state - Logged in:', isLoggedIn());
            console.log('📊 Products loaded:', allProducts.length);
        }, 3000);
    });

    // Make functions globally accessible
    window.addToCart = addToCart;
    window.openModal = openModal;
    window.performSearch = performSearch;
    window.logout = logout;
    window.closeLoginPopup = closeLoginPopup;
    window.showLoginPopup = showLoginPopup;
    window.checkPendingAction = checkPendingAction;
    window.handleCartClick = handleCartClick;
    window.loadProducts = loadProducts;
    window.showDebugInfo = showDebugInfo;
    window.setTestLogin = setTestLogin;
    window.isLoggedIn = isLoggedIn;
    window.updateNavbar = updateNavbar;
    window.clearSearch = clearSearch;
    window.loadSearchResults = loadSearchResults;
</script>
</body>
</html>