<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const API_URL = 'http://localhost:5000/api';
    let currentPage = 1;
    const limit = 9;
    let allCategories = [];
    let currentSubcategoryId = '';
    let currentSubcategoryName = '';
    let currentCategoryId = '';
    let currentCategoryName = '';

    // ================================================================
    // CHECK LOGIN STATUS
    // ================================================================
    function isLoggedIn() {
        const token = localStorage.getItem('token');
        if (token && token !== 'null' && token !== 'undefined' && token !== '') {
            return true;
        }
        return false;
    }

    // ================================================================
    // LOGIN POPUP
    // ================================================================
    let pendingProductId = null;
    let pendingAction = null;
    let pendingRedirect = null;

    function showLoginPopup(productId, action, redirect) {
        pendingProductId = productId;
        pendingAction = action || 'addtocart';
        pendingRedirect = redirect || null;
        
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeLoginPopup() {
        const popup = document.getElementById('loginPopup');
        if (popup) {
            popup.classList.remove('show');
            document.body.style.overflow = '';
        }
        pendingProductId = null;
        pendingAction = null;
        pendingRedirect = null;
    }

    document.getElementById('loginPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeLoginPopup();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeLoginPopup();
        }
    });

    // ================================================================
    // CART ICON CLICK
    // ================================================================
    function handleCartClick(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        
        if (!isLoggedIn()) {
            showLoginPopup(null, 'redirect', '/cart');
            return false;
        }
        
        window.location.href = '/cart';
        return false;
    }

    // ================================================================
    // CART FUNCTIONS
    // ================================================================
    function getCart() { 
        try {
            return JSON.parse(localStorage.getItem('cart')) || []; 
        } catch(e) {
            return [];
        }
    }
    
    function saveCart(c) { 
        localStorage.setItem('cart', JSON.stringify(c)); 
        updateCartCount(); 
    }
    
    function updateCartCount() {
        const cart = getCart();
        const total = cart.reduce((s, i) => s + i.quantity, 0);
        const badge = document.getElementById('cartCount');
        if (badge) { 
            badge.textContent = total; 
            badge.style.display = total > 0 ? 'inline-block' : 'none'; 
        }
    }

    // ================================================================
    // ADD TO CART
    // ================================================================
    function addToCart(event, id) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        
        console.log('🛒 Add to Cart clicked for product:', id);
        
        if (!isLoggedIn()) {
            showLoginPopup(id, 'addtocart');
            return false;
        }
        
        let cart = getCart();
        const existing = cart.find(i => i.productId === id);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ productId: id, quantity: 1 });
        }
        saveCart(cart);
        showToast('✅ Added to cart!', 'success');
        return false;
    }

    // ================================================================
    // CHECK PENDING ACTION
    // ================================================================
    function checkPendingAction() {
        if (pendingProductId && pendingAction) {
            const productId = pendingProductId;
            const action = pendingAction;
            const redirect = pendingRedirect;
            
            pendingProductId = null;
            pendingAction = null;
            pendingRedirect = null;
            
            if (action === 'addtocart') {
                let cart = getCart();
                const existing = cart.find(i => i.productId === productId);
                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({ productId: productId, quantity: 1 });
                }
                saveCart(cart);
                showToast('✅ Added to cart!', 'success');
            } else if (action === 'redirect' && redirect) {
                window.location.href = redirect;
            }
        }
    }

    // ================================================================
    // TOAST
    // ================================================================
    function showToast(msg, type = 'info') {
        let container = document.getElementById('toastContainer');
        if (!container) { 
            container = document.createElement('div'); 
            container.id = 'toastContainer'; 
            container.className = 'toast-container position-fixed top-0 end-0 p-3'; 
            document.body.appendChild(container); 
        }
        const bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white ${bg} border-0 show`;
        toast.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.parentElement.parentElement.remove()"></button></div>`;
        container.appendChild(toast);
        setTimeout(() => { if (toast.parentElement) { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); } }, 3000);
    }

    // ================================================================
    // HELPERS
    // ================================================================
    function formatPrice(p) { return `₹${Number(p).toFixed(2)}`; }
    
    function getStars(r) { if (!r) return '☆☆☆☆☆'; let s = ''; for (let i = 0; i < Math.floor(r); i++) s += '★'; if (r % 1 >= 0.5) s += '½'; for (let i = s.length; i < 5; i++) s += '☆'; return s; }
    
    function getIcon(cat) {
        const map = { 'clothing': 'fa-tshirt', 'fashion': 'fa-tshirt', 'electronics': 'fa-laptop', 'mobile': 'fa-mobile-alt', 'jewellery': 'fa-gem', 'jewelry': 'fa-gem', 'footwear': 'fa-shoe-prints', 'shoes': 'fa-shoe-prints', 'accessories': 'fa-glasses', 'watch': 'fa-clock', 'watches': 'fa-clock', 'beauty': 'fa-mask', 'home': 'fa-couch', 'furniture': 'fa-couch', 'sports': 'fa-running', 'books': 'fa-book', 'toys': 'fa-robot', 'gaming': 'fa-gamepad', 'default': 'fa-folder' };
        const l = cat?.toLowerCase() || '';
        for (const [k, v] of Object.entries(map)) { if (l.includes(k)) return v; }
        return map.default;
    }
    
    async function apiCall(endpoint) {
        const res = await fetch(`${API_URL}${endpoint}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'API error');
        return data;
    }

    // ================================================================
    // 🔥 FIX: LOAD CATEGORIES - WITH URL PARAMS
    // ================================================================
    async function loadCategories() {
        try {
            allCategories = await apiCall('/categories');
            const select = document.getElementById('filterCategory');
            select.innerHTML = '<option value="">All Categories</option>';
            
            allCategories.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat._id;
                opt.textContent = cat.name;
                select.appendChild(opt);
            });
            
            // ✅ Read URL parameters
            const params = new URLSearchParams(window.location.search);
            const catId = params.get('category');
            const subId = params.get('subcategory');
            const search = params.get('search');
            
            console.log('🔍 URL Params:', { catId, subId, search });
            
            // ✅ Set category from URL
            if (catId) {
                const cat = allCategories.find(c => c._id === catId);
                if (cat) {
                    currentCategoryId = catId;
                    currentCategoryName = cat.name;
                    select.value = catId;
                    await loadSubcategories(catId);
                }
            }
            
            // ✅ Set subcategory from URL
            if (subId) {
                let found = false;
                for (let cat of allCategories) {
                    if (cat.subcategories) {
                        const sub = cat.subcategories.find(s => s._id === subId);
                        if (sub) {
                            currentSubcategoryId = subId;
                            currentSubcategoryName = sub.name;
                            currentCategoryId = cat._id;
                            currentCategoryName = cat.name;
                            found = true;
                            
                            document.getElementById('filterCategory').value = cat._id;
                            await loadSubcategories(cat._id);
                            
                            setTimeout(() => {
                                const subSelect = document.getElementById('filterSubcategory');
                                for (let opt of subSelect.options) {
                                    if (opt.value === subId) {
                                        opt.selected = true;
                                        break;
                                    }
                                }
                            }, 100);
                            
                            break;
                        }
                    }
                }
                
                if (!found) {
                    console.warn('⚠️ Subcategory not found:', subId);
                }
            }
            
            // ✅ Set search value
            if (search) {
                document.getElementById('shopSearchInput').value = search;
                console.log('✅ Search term set:', search);
            }
            
            updateFilterInfo();
            await loadProducts();
            
        } catch (e) { 
            console.error('Error loading categories:', e);
            await loadProducts();
        }
    }

    // ================================================================
    // 🔥 FIX: LOAD SUBCATEGORIES
    // ================================================================
    async function loadSubcategories(categoryId) {
        try {
            const cat = allCategories.find(c => c._id === categoryId);
            const select = document.getElementById('filterSubcategory');
            select.innerHTML = '<option value="">All Subcategories</option>';
            
            if (cat && cat.subcategories && cat.subcategories.length > 0) {
                cat.subcategories.forEach(sub => {
                    const opt = document.createElement('option');
                    opt.value = sub._id;
                    opt.textContent = sub.name;
                    select.appendChild(opt);
                });
            }
            
            const params = new URLSearchParams(window.location.search);
            const subId = params.get('subcategory');
            
            if (subId) {
                for (let opt of select.options) {
                    if (opt.value === subId) {
                        opt.selected = true;
                        currentSubcategoryId = subId;
                        currentSubcategoryName = opt.textContent;
                        break;
                    }
                }
            }
            
            console.log('✅ Subcategories loaded for category:', categoryId);
            
        } catch (e) { 
            console.error('Error loading subcategories:', e); 
        }
    }

    // ================================================================
    // 🔥 FIX: UPDATE FILTER INFO
    // ================================================================
    function updateFilterInfo() {
        const filterInfo = document.getElementById('filterInfo');
        const params = new URLSearchParams(window.location.search);
        const subId = params.get('subcategory');
        const catId = params.get('category');
        const search = params.get('search');
        const searchInput = document.getElementById('shopSearchInput').value.trim();
        
        let info = '';
        const searchTerm = search || searchInput;
        
        if (searchTerm) {
            info = `<i class="fas fa-search me-2"></i> Showing results for: <strong>${searchTerm}</strong>`;
        } else if (subId && currentSubcategoryName) {
            info = `<i class="fas fa-tag me-2"></i> Showing products in: <strong>${currentSubcategoryName}</strong> <span class="text-muted">(${currentCategoryName})</span>`;
        } else if (catId && currentCategoryName) {
            info = `<i class="fas fa-folder me-2"></i> Showing products in: <strong>${currentCategoryName}</strong>`;
        } else {
            info = `<i class="fas fa-store me-2"></i> All Products`;
        }
        filterInfo.innerHTML = info;
    }

    // ================================================================
    // 🔥 FIX: LOAD PRODUCTS - WITH SUBCATEGORY FILTER
    // ================================================================
    async function loadProducts() {
        const category = document.getElementById('filterCategory').value;
        const subcategory = document.getElementById('filterSubcategory').value;
        const minPrice = document.getElementById('filterMinPrice').value;
        const maxPrice = document.getElementById('filterMaxPrice').value;
        const sort = document.getElementById('filterSort').value;
        const search = document.getElementById('shopSearchInput').value.trim();

        let query = `?page=${currentPage}&limit=${limit}`;
        
        if (search) {
            query += `&search=${encodeURIComponent(search)}`;
            console.log('🔍 Searching for:', search);
        }
        
        if (category) {
            query += `&category=${category}`;
            console.log('📂 Category filter:', category);
        }
        
        // ✅ IMPORTANT: Subcategory filter
        if (subcategory) {
            query += `&subcategory=${subcategory}`;
            const subName = document.getElementById('filterSubcategory').options[document.getElementById('filterSubcategory').selectedIndex]?.text || '';
            console.log('📂 Subcategory filter:', subcategory, subName);
        }
        
        if (minPrice) query += `&minPrice=${minPrice}`;
        if (maxPrice) query += `&maxPrice=${maxPrice}`;
        if (sort) query += `&sort=${sort}`;

        console.log('📡 API Query:', `/products${query}`);

        try {
            const data = await apiCall(`/products${query}`);
            
            let products = [];
            let total = 0;
            
            if (data.products && Array.isArray(data.products)) {
                products = data.products;
                total = data.total || products.length;
            } else if (Array.isArray(data)) {
                products = data;
                total = data.length;
            } else {
                products = [];
                total = 0;
            }
            
            console.log(`📦 Found ${products.length} products out of ${total}`);
            
            const totalPages = Math.ceil(total / limit);
            renderProducts(products);
            renderPagination(total, totalPages);
            document.getElementById('resultCount').textContent = `${products.length} of ${total} products`;
            
            updateFilterInfo();
            
        } catch (e) {
            console.error('❌ Error loading products:', e);
            document.getElementById('productGrid').innerHTML = `<div class="col-12 text-center text-danger">Failed to load products: ${e.message}</div>`;
        }
    }

    // ================================================================
    // RENDER PRODUCTS
    // ================================================================
    function renderProducts(products) {
        const grid = document.getElementById('productGrid');
        if (!products || products.length === 0) {
            grid.innerHTML = `<div class="col-12 text-center py-5"><i class="fas fa-box-open fa-4x text-muted"></i><h5 class="mt-3">No products found</h5></div>`;
            return;
        }
        grid.innerHTML = products.map(p => {
            const price = Number(p.price) || 0;
            const sale = p.salePrice ? Number(p.salePrice) : null;
            const display = sale && sale < price ? sale : price;
            const showOriginal = sale && sale < price;
            const discount = showOriginal ? Math.round(((price - sale) / price) * 100) : null;
            const img = p.mainImage || p.image || 'https://via.placeholder.com/300x300';
            return `
                <div class="col-md-4 col-sm-6">
                    <a href="/product-detail?id=${p._id}" class="product-link">
                        <div class="product-card">
                            <div class="product-img">
                                <img src="${img}" alt="${p.name}" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\\'fas ${getIcon(p.category)}\\'></i>'">
                            </div>
                            <div class="p-3">
                                <h6 class="fw-bold" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;height:44px;">${p.name || 'Product'}</h6>
                                <div class="rating">${getStars(p.rating || 4)}</div>
                                <div class="d-flex align-items-center flex-wrap">
                                    <span class="current-price">${formatPrice(display)}</span>
                                    ${showOriginal ? `<span class="original-price">${formatPrice(price)}</span>` : ''}
                                    ${discount ? `<span class="sale-badge">-${discount}%</span>` : ''}
                                </div>
                                <button class="btn btn-primary-blue w-100 mt-2" style="font-size:0.8rem;padding:6px 12px;" onclick="addToCart(event, '${p._id}')">
                                    <i class="fas fa-shopping-cart"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </a>
                </div>
            `;
        }).join('');
    }

    // ================================================================
    // PAGINATION
    // ================================================================
    function renderPagination(total, totalPages) {
        const pagination = document.getElementById('pagination');
        if (totalPages <= 1) { pagination.innerHTML = ''; return; }
        let html = '';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" onclick="changePage(${currentPage - 1})">Previous</a></li>`;
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" onclick="changePage(${i})">${i}</a></li>`;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" onclick="changePage(${currentPage + 1})">Next</a></li>`;
        pagination.innerHTML = html;
    }

    function changePage(page) { currentPage = page; loadProducts(); window.scrollTo({ top: 0, behavior: 'smooth' }); }

    // ================================================================
    // 🔥 FIX: EVENT LISTENERS - SUBCATEGORY CHANGE AUTO LOAD
    // ================================================================
    
    // ✅ Subcategory change - Auto load products
    document.getElementById('filterSubcategory').addEventListener('change', function() {
        const subId = this.value;
        const subName = this.options[this.selectedIndex]?.text || '';
        
        console.log('📂 Subcategory changed:', subId, subName);
        
        if (subId) {
            currentSubcategoryId = subId;
            currentSubcategoryName = subName;
            
            const catId = document.getElementById('filterCategory').value;
            if (catId) {
                const cat = allCategories.find(c => c._id === catId);
                if (cat) {
                    currentCategoryName = cat.name;
                }
            }
            
            const url = new URL(window.location);
            url.searchParams.set('subcategory', subId);
            if (catId) url.searchParams.set('category', catId);
            window.history.pushState({}, '', url);
            
        } else {
            currentSubcategoryId = '';
            currentSubcategoryName = '';
            
            const url = new URL(window.location);
            url.searchParams.delete('subcategory');
            window.history.pushState({}, '', url);
        }
        
        currentPage = 1;
        loadProducts();
        updateFilterInfo();
    });

    // ✅ Category change - Load subcategories and products
    document.getElementById('filterCategory').addEventListener('change', function() {
        const catId = this.value;
        const catName = this.options[this.selectedIndex]?.text || '';
        
        console.log('📂 Category changed:', catId, catName);
        
        if (catId) {
            currentCategoryId = catId;
            currentCategoryName = catName;
            
            const url = new URL(window.location);
            url.searchParams.set('category', catId);
            url.searchParams.delete('subcategory');
            window.history.pushState({}, '', url);
            
            loadSubcategories(catId);
            
            document.getElementById('filterSubcategory').value = '';
            currentSubcategoryId = '';
            currentSubcategoryName = '';
            
        } else {
            currentCategoryId = '';
            currentCategoryName = '';
            
            const url = new URL(window.location);
            url.searchParams.delete('category');
            url.searchParams.delete('subcategory');
            window.history.pushState({}, '', url);
            
            const subSelect = document.getElementById('filterSubcategory');
            subSelect.innerHTML = '<option value="">All Subcategories</option>';
            currentSubcategoryId = '';
            currentSubcategoryName = '';
        }
        
        currentPage = 1;
        loadProducts();
        updateFilterInfo();
    });

    // ================================================================
    // APPLY & CLEAR FILTERS
    // ================================================================
    document.getElementById('applyFilters').addEventListener('click', () => { 
        currentPage = 1; 
        loadProducts(); 
        updateFilterInfo();
    });
    
    document.getElementById('clearFilters').addEventListener('click', () => {
        document.getElementById('filterCategory').value = '';
        document.getElementById('filterSubcategory').innerHTML = '<option value="">All Subcategories</option>';
        document.getElementById('filterMinPrice').value = '';
        document.getElementById('filterMaxPrice').value = '';
        document.getElementById('filterSort').value = 'createdAt_desc';
        document.getElementById('shopSearchInput').value = '';
        currentSubcategoryId = '';
        currentSubcategoryName = '';
        currentCategoryId = '';
        currentCategoryName = '';
        currentPage = 1;
        
        const url = new URL(window.location);
        url.searchParams.delete('category');
        url.searchParams.delete('subcategory');
        url.searchParams.delete('search');
        window.history.pushState({}, '', url);
        
        loadProducts();
        updateFilterInfo();
    });
    
    document.getElementById('shopSearchBtn').addEventListener('click', () => { 
        currentPage = 1; 
        loadProducts(); 
        updateFilterInfo(); 
    });
    
    document.getElementById('shopSearchInput').addEventListener('keypress', e => { 
        if (e.key === 'Enter') { 
            currentPage = 1; 
            loadProducts(); 
            updateFilterInfo(); 
        } 
    });

    // ================================================================
    // LOGOUT
    // ================================================================
    function logout() {
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        showToast('✅ Logged out successfully!', 'success');
        setTimeout(() => { window.location.href = '/'; }, 500);
    }

    // ================================================================
    // UPDATE NAVBAR
    // ================================================================
    function updateNavbar() {
        const token = localStorage.getItem('token');
        const user = JSON.parse(localStorage.getItem('user') || '{}');
        const dropdown = document.getElementById('authDropdown');

        if (token && token !== 'null' && token !== 'undefined') {
            dropdown.innerHTML = `
                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>${user.name || 'My Account'}</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
            `;
        } else {
            dropdown.innerHTML = `
                <li><a class="dropdown-item" href="/login"><i class="fas fa-sign-in-alt me-2"></i>Login</a></li>
                <li><a class="dropdown-item" href="/register"><i class="fas fa-user-plus me-2"></i>Register</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
            `;
        }
    }

    // ================================================================
    // INIT
    // ================================================================
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Shop page loaded!');
        updateCartCount();
        loadCategories();
        updateNavbar();
        checkPendingAction();
    });

    // Make functions globally accessible
    window.addToCart = addToCart;
    window.changePage = changePage;
    window.logout = logout;
    window.closeLoginPopup = closeLoginPopup;
    window.showLoginPopup = showLoginPopup;
    window.checkPendingAction = checkPendingAction;
    window.handleCartClick = handleCartClick;
</script>
</body>
</html>