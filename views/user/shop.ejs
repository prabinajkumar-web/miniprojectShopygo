</nav>

<!-- ===== LOGIN POPUP ===== -->
<div class="login-popup-overlay" id="loginPopup">
    <div class="login-popup">
        <button type="button" class="popup-close" onclick="closeLoginPopup()">&times;</button>
        <div class="icon"><i class="fas fa-user-circle"></i></div>
