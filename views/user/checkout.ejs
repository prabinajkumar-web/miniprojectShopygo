                        <li><a class="dropdown-item" href="/register"><i class="fas fa-user-plus me-2"></i>Register</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- ===== LOADING SPINNER ===== -->
<div class="spinner-overlay" id="spinnerOverlay">
    <div class="spinner"></div>
</div>

<!-- ===== LOGIN POPUP ===== -->
<div class="login-popup-overlay" id="loginPopup">
    <div class="login-popup">
        <div class="icon"><i class="fas fa-user-circle"></i></div>
        <h4>Login Required</h4>
        <p>Please login to complete your order</p>
        <div class="d-grid gap-2 mt-3">
            <a href="/login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt me-2"></i> Login
            </a>
            <a href="/register" class="btn btn-outline-primary">
                <i class="fas fa-user-plus me-2"></i> Create Account
            </a>
            <button class="btn btn-outline-secondary" onclick="closeLoginPopup()">
                <i class="fas fa-times me-2"></i> Cancel
            </button>
        </div>
    </div>
</div>

<!-- ===== MAIN CONTENT ===== -->
<main class="container my-4">
    <h2 class="fw-bold"><i class="fas fa-credit-card text-primary-blue"></i> Checkout</h2>
    <hr>
    <div class="row">
        <div class="col-lg-7">
            <div class="checkout-card">
                <h5 class="fw-bold">Shipping Address</h5>
                <form id="checkoutForm">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" id="fullName" class="form-control" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" id="email" class="form-control" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-semibold">Address</label>
                            <input type="text" id="address" class="form-control" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">City</label>
                            <input type="text" id="city" class="form-control" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">ZIP Code</label>
                            <input type="text" id="zip" class="form-control" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-semibold">Phone</label>
                            <input type="tel" id="phone" class="form-control" required>
                        </div>
                    </div>
                    <h5 class="fw-bold mt-4">Payment Method</h5>
                    <div class="mb-3">
                        <select id="paymentMethod" class="form-select" required>
                            <option value="">Select payment method</option>
                            <option value="cod">💵 Cash on Delivery</option>
                            <option value="card">💳 Credit/Debit Card</option>
                            <option value="upi">📱 UPI</option>
                            <option value="netbanking">🏦 Net Banking</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-checkout" id="placeOrderBtn">
                        <i class="fas fa-check"></i> Place Order
                    </button>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="cart-summary">
                <h4>Order Summary</h4>
                <div id="orderSummary">
                    <p class="text-muted">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</main>

