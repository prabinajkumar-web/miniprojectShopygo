<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const API_URL = 'http://localhost:5000/api';

    // ================================================================
    // CHECK LOGIN STATUS
    // ================================================================
    function isLoggedIn() {
        const token = localStorage.getItem('token');
        return token && token !== 'null' && token !== 'undefined' && token !== '';
    }

    function getCurrentUser() {
        const user = localStorage.getItem('user');
        if (user && user !== 'null' && user !== 'undefined') {
            try {
                return JSON.parse(user);
            } catch (e) {
                return null;
            }
        }
        return null;
    }

    function getToken() {
        return localStorage.getItem('token');
    }

    // ================================================================
    // LOGIN POPUP
    // ================================================================
    function showLoginPopup() {
        document.getElementById('loginPopup').classList.add('show');
    }

    function closeLoginPopup() {
        document.getElementById('loginPopup').classList.remove('show');
    }

    document.getElementById('loginPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeLoginPopup();
        }
    });

    // ================================================================
    // LOADING SPINNER
    // ================================================================
    function showLoading() {
        document.getElementById('spinnerOverlay').classList.add('show');
    }

    function hideLoading() {
        document.getElementById('spinnerOverlay').classList.remove('show');
    }

    // ================================================================
    // CART FUNCTIONS
    // ================================================================
    function getCart() { 
        try {
            return JSON.parse(localStorage.getItem('cart')) || []; 
        } catch(e) { 
            return []; 
        }
    }
    
    function clearCart() { 
        localStorage.removeItem('cart'); 
        updateCartCount(); 
    }
    
    function updateCartCount() {
        const cart = getCart();
        const total = cart.reduce((s, i) => s + (i.quantity || 0), 0);
        const badge = document.getElementById('cartCount');
        if (badge) { 
            badge.textContent = total; 
            badge.style.display = total > 0 ? 'inline-block' : 'none'; 
        }
    }

    function showToast(msg, type = 'info') {
        let container = document.getElementById('toastContainer');
        if (!container) { 
            container = document.createElement('div'); 
            container.id = 'toastContainer'; 
            container.className = 'toast-container position-fixed top-0 end-0 p-3'; 
            document.body.appendChild(container); 
        }
        const bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white ${bg} border-0 show`;
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">${msg}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
        `;
        container.appendChild(toast);
        setTimeout(() => { 
            if (toast.parentElement) { 
                toast.classList.remove('show'); 
                setTimeout(() => toast.remove(), 300); 
            } 
        }, 4000);
    }

    function formatPrice(p) { 
        const num = Number(p);
        if (isNaN(num) || num === 0) return '₹0.00';
        return `₹${num.toFixed(2)}`; 
    }

    // ================================================================
    // GENERATE ORDER ID
    // ================================================================
    function generateOrderId() {
        const timestamp = Date.now().toString().slice(-8);
        const random = Math.random().toString(36).substring(2, 6).toUpperCase();
        return 'ORD' + timestamp + random;
    }

    // ================================================================
    // FETCH PRODUCT PRICE
    // ================================================================
    async function fetchProductPrice(productId) {
        try {
            const response = await fetch(`${API_URL}/products/${productId}`);
            if (!response.ok) return null;
            const product = await response.json();
            return product.salePrice || product.price || null;
        } catch (e) {
            console.error('Error fetching product:', e);
            return null;
        }
    }

    // ================================================================
    // RENDER ORDER SUMMARY - FIXED WITH PRODUCT PRICES
    // ================================================================
    async function renderOrderSummary() {
        const cart = getCart();
        const container = document.getElementById('orderSummary');

        if (cart.length === 0) {
            container.innerHTML = `
                <p class="text-muted">Your cart is empty</p>
                <a href="/shop" class="btn btn-primary-blue w-100">Shop Now</a>
            `;
            return null;
        }

        let subtotal = 0;
        let totalItems = 0;
        let itemsHtml = '';

        // ✅ Fetch product prices from database
        for (let item of cart) {
            let price = Number(item.price) || 0;
            
            // If price is 0, try to fetch from database
            if (price === 0 && item.productId) {
                const dbPrice = await fetchProductPrice(item.productId);
                if (dbPrice) {
                    price = dbPrice;
                    // Update cart item price
                    item.price = price;
                }
            }
            
            // If still 0, set default price
            if (price === 0) {
                price = 999; // Default price
                item.price = price;
            }
            
            const quantity = Number(item.quantity) || 1;
            subtotal += price * quantity;
            totalItems += quantity;
            
            const productName = item.name || 'Product';
            const imageUrl = item.image || null;
            
            itemsHtml += `
                <div class="cart-item">
                    ${imageUrl ? `<img src="${imageUrl}" class="item-img" onerror="this.style.display='none'" alt="${productName}">` : ''}
                    <div class="item-info">
                        <div class="item-name">${productName}</div>
                        <div class="item-meta">Qty: ${quantity} × ${formatPrice(price)}</div>
                    </div>
                    <div class="item-price">${formatPrice(price * quantity)}</div>
                </div>
            `;
        }

        // Save updated cart back to localStorage
        localStorage.setItem('cart', JSON.stringify(cart));

        const shipping = subtotal > 500 ? 0 : 49;
        const tax = subtotal * 0.08;
        const total = subtotal + shipping + tax;

        container.innerHTML = `
            <div style="max-height: 300px; overflow-y: auto; margin-bottom: 12px;">
                ${itemsHtml}
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal (${totalItems} items)</span>
                <span class="fw-bold">${formatPrice(subtotal)}</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Shipping</span>
                <span class="fw-bold">${shipping === 0 ? 'Free' : formatPrice(shipping)}</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Tax (8%)</span>
                <span class="fw-bold">${formatPrice(tax)}</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between">
                <span class="h5 fw-bold">Total</span>
                <span class="h5 text-primary-blue fw-bold">${formatPrice(total)}</span>
            </div>
        `;
        
        return { subtotal, shipping, tax, total, totalItems };
    }

    // ================================================================
    // ✅ PLACE ORDER - WITH PROPER PRICES
    // ================================================================
    document.getElementById('checkoutForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const btn = document.getElementById('placeOrderBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order...';
        
        try {
            if (!isLoggedIn()) {
                showLoginPopup();
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                return;
            }
            
            let cart = getCart();
            if (cart.length === 0) { 
                showToast('Cart is empty', 'error'); 
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                return; 
            }

            const user = getCurrentUser();
            
            const fullName = document.getElementById('fullName').value.trim();
            const email = document.getElementById('email').value.trim();
            const address = document.getElementById('address').value.trim();
            const city = document.getElementById('city').value.trim();
            const zip = document.getElementById('zip').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const paymentMethod = document.getElementById('paymentMethod').value;

            if (!fullName || !email || !address || !city || !zip || !phone) {
                showToast('Please fill all fields', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                return;
            }

            if (!paymentMethod) {
                showToast('Please select a payment method', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                return;
            }

            // ✅ Calculate subtotal with proper prices
            let subtotal = 0;
            const orderItems = [];

            for (let item of cart) {
                let price = Number(item.price) || 0;
                
                // If price is 0, try to fetch from database
                if (price === 0 && item.productId) {
                    const dbPrice = await fetchProductPrice(item.productId);
                    if (dbPrice) {
                        price = dbPrice;
                        item.price = price;
                    }
                }
                
                // If still 0, set default price
                if (price === 0) {
                    price = 999;
                    item.price = price;
                }
                
                const quantity = Number(item.quantity) || 1;
                subtotal += price * quantity;
                
                orderItems.push({
                    productId: item.productId || 'unknown',
                    productName: item.name || 'Product',
                    quantity: quantity,
                    price: price,
                    category: item.category || 'Uncategorized',
                    size: item.size || null,
                    color: item.color || null,
                    image: item.image || null,
                    subtotal: price * quantity
                });
            }

            // Save updated cart
            localStorage.setItem('cart', JSON.stringify(cart));

            const shipping = subtotal > 500 ? 0 : 49;
            const tax = subtotal * 0.08;
            const total = subtotal + shipping + tax;

            const orderId = generateOrderId();

            const orderData = {
                orderNumber: orderId,
                userId: user?.id || user?._id || null,
                items: orderItems,
                subtotal: subtotal,
                shippingCharge: shipping,
                tax: tax,
                totalAmount: total,
                status: 'pending',
                paymentMethod: paymentMethod,
                paymentStatus: 'pending',
                shippingAddress: {
                    name: fullName,
                    email: email,
                    address: address,
                    city: city,
                    state: 'N/A',
                    pincode: zip,
                    phone: phone
                },
                createdAt: new Date().toISOString()
            };

            console.log('📦 Order Data:', orderData);

            // ✅ SAVE TO DATABASE
            showLoading();
            
            try {
                const token = getToken();
                
                const response = await fetch(`${API_URL}/orders`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': token ? `Bearer ${token}` : ''
                    },
                    body: JSON.stringify(orderData)
                });
                
                console.log('📊 Response Status:', response.status);
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || `HTTP ${response.status}`);
                }
                
                const result = await response.json();
                console.log('✅ Order saved to database:', result);
                
                showToast(`✅ Order #${orderId} placed successfully!`, 'success');
                
                // ✅ Clear cart
                clearCart();
                
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                hideLoading();
                
                // ✅ Redirect to My Orders
                setTimeout(() => { 
                    window.location.href = '/my-orders'; 
                }, 1500);
                
            } catch (dbError) {
                console.error('❌ Database save error:', dbError);
                showToast('❌ Failed to save order: ' + dbError.message, 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
                hideLoading();
            }
            
        } catch (error) {
            console.error('❌ Error placing order:', error);
            showToast('❌ Error placing order: ' + error.message, 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check"></i> Place Order';
            hideLoading();
        }
    });

    // ================================================================
    // LOGOUT
    // ================================================================
    function logout() {
        if (confirm('Are you sure you want to logout?')) {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            showToast('✅ Logged out successfully!', 'success');
            setTimeout(() => { window.location.href = '/'; }, 500);
        }
    }

    // ================================================================
    // UPDATE NAVBAR
    // ================================================================
    function updateNavbar() {
        const token = getToken();
        const user = getCurrentUser();
        const dropdown = document.getElementById('authDropdown');

        if (token && token !== 'null' && token !== 'undefined') {
            dropdown.innerHTML = `
                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>${user?.name || 'My Account'}</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
            `;
        } else {
            dropdown.innerHTML = `
                <li><a class="dropdown-item" href="/login"><i class="fas fa-sign-in-alt me-2"></i>Login</a></li>
                <li><a class="dropdown-item" href="/register"><i class="fas fa-user-plus me-2"></i>Register</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
            `;
        }
    }

    // ================================================================
    // INIT
    // ================================================================
    document.addEventListener('DOMContentLoaded', async () => {
        console.log('💳 Checkout page loaded');
        updateCartCount();
        updateNavbar();
        
        if (!isLoggedIn()) {
            showLoginPopup();
        }
        
        const user = getCurrentUser();
        if (user) {
            if (user.name) document.getElementById('fullName').value = user.name || '';
            if (user.email) document.getElementById('email').value = user.email || '';
        }
        
        const cart = getCart();
        if (cart.length === 0) {
            showToast('Cart is empty', 'error');
            setTimeout(() => { window.location.href = '/shop'; }, 1500);
        }
        
        await renderOrderSummary();
    });

    // Make functions globally accessible
    window.logout = logout;
    window.closeLoginPopup = closeLoginPopup;
    window.showLoginPopup = showLoginPopup;
    window.isLoggedIn = isLoggedIn;
    window.getToken = getToken;
</script>
</body>
</html>