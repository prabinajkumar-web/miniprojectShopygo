<!-- ===== SCRIPTS ===== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script>
    var API_URL = '/api';

    function isLoggedIn() {
        var token = localStorage.getItem('token');
        if (token && token !== 'null' && token !== 'undefined' && token !== '') {
            return true;
        }
        return false;
    }

    function getCart() { 
        try {
            return JSON.parse(localStorage.getItem('cart')) || []; 
        } catch(e) {
            return [];
        }
    }
    
    function updateCartCount() {
        var cart = getCart();
        var total = cart.reduce(function(s, i) { return s + i.quantity; }, 0);
        var badge = document.getElementById('cartCount');
        if (badge) { 
            badge.textContent = total; 
            badge.style.display = total > 0 ? 'inline-block' : 'none'; 
        }
    }

    function handleCartClick(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        if (!isLoggedIn()) {
            window.location.href = '/login';
            return false;
        }
        window.location.href = '/cart';
        return false;
    }

    function logout() {
        if (confirm('Are you sure you want to logout?')) {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            localStorage.removeItem('cart');
            window.location.href = '/';
        }
    }

    function updateNavbar() {
        var token = localStorage.getItem('token');
        var user = JSON.parse(localStorage.getItem('user') || '{}');
        var dropdown = document.getElementById('authDropdown');

        if (token && token !== 'null' && token !== 'undefined') {
            dropdown.innerHTML = 
                '<li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>' + (user.name || 'My Account') + '</a></li>' +
                '<li><hr class="dropdown-divider"></li>' +
                '<li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>' +
                '<li><hr class="dropdown-divider"></li>' +
                '<li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>';
        } else {
            dropdown.innerHTML = 
                '<li><a class="dropdown-item" href="/login"><i class="fas fa-sign-in-alt me-2"></i>Login</a></li>' +
                '<li><a class="dropdown-item" href="/register"><i class="fas fa-user-plus me-2"></i>Register</a></li>' +
                '<li><hr class="dropdown-divider"></li>' +
                '<li><a class="dropdown-item" href="/my-orders"><i class="fas fa-box me-2"></i>My Orders</a></li>';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();
        updateNavbar();
    });

    window.handleCartClick = handleCartClick;
    window.logout = logout;
</script>
