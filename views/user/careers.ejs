            padding: 80px 0 60px;
            color: white;
            text-align: center;
            border-radius: 0 0 40px 40px;
            margin-bottom: 60px;
            position: relative;
            overflow: hidden;
        }
        .careers-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 600px;
            height: 600px;
            background: rgba(37, 99, 235, 0.1);
            border-radius: 50%;
        }
        .careers-hero::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: rgba(37, 99, 235, 0.08);
            border-radius: 50%;
        }
        .careers-hero h1 {
            font-size: 3.5rem;
