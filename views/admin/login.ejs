<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - ShopyGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #2563eb, #1e40af);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        .auth-card {
            background: white;
            border-radius: 24px;
            padding: 48px 40px;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .auth-card .logo {
            text-align: center;
            margin-bottom: 32px;
        }
        .auth-card .logo h2 {
            font-weight: 800;
            color: #2563eb;
        }
        .auth-card .logo p {
            color: #64748b;
            font-size: 0.85rem;
        }
        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
        }
        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
        }
        .btn-primary-custom {
            background: #2563eb;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            color: white;
            transition: 0.3s;
        }
        .btn-primary-custom:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,0.3);
        }
        .btn-primary-custom:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        .otp-section {
            display: none;
        }
        .otp-section.show {
            display: block;
        }
        .resend-btn {
            background: none;
            border: none;
            color: #2563eb;
            font-weight: 600;
            cursor: pointer;
        }
        .resend-btn:hover {
            text-decoration: underline;
        }
        .timer {
            color: #64748b;
            font-size: 0.85rem;
        }
        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
        }
        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }
        .divider span {
            padding: 0 16px;
            color: #94a3b8;
            font-size: 0.8rem;
        }
        .toast-notify {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 0.85rem;
            z-index: 1100;
            display: flex;
            align-items: center;
            gap: 8px;
            animation: fadeInUp 0.3s ease;
        }
        .toast-notify.error { background: #dc2626; color: white; }
        .toast-notify.success { background: #16a34a; color: white; }
        .toast-notify.info { background: #2563eb; color: white; }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .otp-input {
            letter-spacing: 8px;
            font-size: 2rem;
            font-weight: 700;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="auth-card">
    <div class="logo">
        <div style="font-size: 3rem;">🛒</div>
        <h2>ShopyGo Admin</h2>
        <p>Secure admin access with OTP</p>
    </div>

    <!-- Login Section -->
    <div id="loginSection">
        <div class="mb-3">
            <label class="form-label fw-semibold">Email Address</label>
            <input type="email" class="form-control" id="adminEmail" placeholder="admin@shopygo.com" required>
        </div>
        <button class="btn-primary-custom" id="sendOtpBtn">
            <i class="bi bi-envelope me-2"></i> Send OTP
        </button>
        <div class="divider"><span>or</span></div>
        <a href="/admin/register" class="btn btn-outline-primary w-100 rounded-pill">
            <i class="bi bi-person-plus me-2"></i> Create Admin Account
        </a>
        <div class="text-center mt-3">
            <a href="/login" class="text-muted small">← User Login</a>
        </div>
    </div>

    <!-- OTP Section -->
    <div id="otpSection" class="otp-section">
        <p class="text-muted small">Enter the 6-digit OTP sent to <strong id="otpEmailDisplay"></strong></p>
        <div class="mb-3">
            <label class="form-label fw-semibold">OTP Code</label>
            <input type="text" class="form-control otp-input" id="otpInput" maxlength="6" placeholder="000000">
        </div>
        <button class="btn-primary-custom" id="verifyOtpBtn">
            <i class="bi bi-shield-lock me-2"></i> Verify & Login
        </button>
        <div class="d-flex justify-content-between mt-3">
            <button class="resend-btn" id="resendOtpBtn"><i class="bi bi-arrow-repeat me-1"></i> Resend OTP</button>
            <span class="timer" id="timerDisplay">05:00</span>
        </div>
        <button class="btn btn-outline-secondary w-100 mt-3 rounded-pill" id="backToEmailBtn">
            <i class="bi bi-arrow-left me-2"></i> Back
        </button>
    </div>
</div>

<script>
    const API_URL = 'http://localhost:5000/api/admin/auth';
    let timerInterval = null;
    let timeLeft = 300;

    // ================================================================
    // TOAST
    // ================================================================
    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `toast-notify ${type}`;
        toast.innerHTML = `<i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill' : 'bi-check-circle-fill'}"></i> ${message}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // ================================================================
    // TIMER
    // ================================================================
    function updateTimer() {
        const mins = Math.floor(timeLeft / 60);
        const secs = timeLeft % 60;
        document.getElementById('timerDisplay').textContent = 
            `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        if (timeLeft <= 0) {
            clearInterval(timerInterval);
            document.getElementById('timerDisplay').textContent = 'Expired';
            document.getElementById('resendOtpBtn').style.display = 'inline';
        }
    }

    function startTimer() {
        timeLeft = 300;
        updateTimer();
        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            timeLeft--;
            updateTimer();
            if (timeLeft <= 0) clearInterval(timerInterval);
        }, 1000);
    }

    // ================================================================
    // SEND OTP
    // ================================================================
    document.getElementById('sendOtpBtn').addEventListener('click', async () => {
        const email = document.getElementById('adminEmail').value.trim();
        if (!email || !email.includes('@')) {
            showToast('Please enter a valid email', 'error');
            return;
        }
        
        const btn = document.getElementById('sendOtpBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Sending...';
        
        try {
            const response = await fetch(`${API_URL}/send-login-otp`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });
            
            const data = await response.json();
            if (!data.success) throw new Error(data.message);
            
            document.getElementById('loginSection').style.display = 'none';
            document.getElementById('otpSection').classList.add('show');
            document.getElementById('otpEmailDisplay').textContent = email;
            document.getElementById('otpInput').value = '';
            document.getElementById('otpInput').focus();
            
            if (data.devOTP) {
                showToast(`🔑 Dev OTP: ${data.devOTP} (Check console)`, 'info');
                console.log('🔑 Development OTP:', data.devOTP);
            } else {
                showToast('✅ OTP sent to your email!', 'success');
            }
            startTimer();
        } catch (error) {
            showToast(error.message || 'Failed to send OTP', 'error');
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-envelope me-2"></i> Send OTP';
    });

    // ================================================================
    // ✅ VERIFY OTP - FIXED: Stores user ID properly
    // ================================================================
    document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
        const email = document.getElementById('adminEmail').value.trim();
        const otp = document.getElementById('otpInput').value.trim();
        
        if (!otp || otp.length !== 6) {
            showToast('Please enter 6-digit OTP', 'error');
            return;
        }
        
        const btn = document.getElementById('verifyOtpBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Verifying...';
        
        try {
            const response = await fetch(`${API_URL}/verify-login-otp`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, otp })
            });
            
            const data = await response.json();
            console.log('📊 Response:', data);
            
            if (!data.success) throw new Error(data.message);
            
            // ✅ FIX: Store user with proper ID
            const user = data.user || {};
            const userData = {
                id: user.id || user._id,      // ✅ Use id or fallback to _id
                _id: user._id || user.id,     // ✅ Store both
                name: user.name || 'Admin',
                email: user.email || email,
                phone: user.phone || '',
                role: user.role || 'admin',
                isActive: user.isActive !== undefined ? user.isActive : true,
                address: user.address || ''
            };
            
            localStorage.setItem('token', data.token);
            localStorage.setItem('user', JSON.stringify(userData));
            
            console.log('✅ User data stored:', userData);
            console.log('✅ User ID:', userData.id);
            
            showToast('✅ Login successful! Redirecting...', 'success');
            setTimeout(() => {
                window.location.href = '/admin-dashboard';
            }, 1500);
            
        } catch (error) {
            console.error('❌ Error:', error);
            showToast(error.message || 'Invalid OTP', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-shield-lock me-2"></i> Verify & Login';
        }
    });

    // ================================================================
    // RESEND OTP
    // ================================================================
    document.getElementById('resendOtpBtn').addEventListener('click', async () => {
        const email = document.getElementById('adminEmail').value.trim();
        const btn = document.getElementById('resendOtpBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Sending...';
        
        try {
            const response = await fetch(`${API_URL}/send-login-otp`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });
            const data = await response.json();
            if (!data.success) throw new Error(data.message);
            
            if (data.devOTP) {
                showToast(`🔑 Dev OTP: ${data.devOTP}`, 'info');
                console.log('🔑 Development OTP:', data.devOTP);
            } else {
                showToast('✅ New OTP sent!', 'success');
            }
            startTimer();
        } catch (error) {
            showToast(error.message || 'Failed to resend OTP', 'error');
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Resend OTP';
    });

    // ================================================================
    // BACK
    // ================================================================
    document.getElementById('backToEmailBtn').addEventListener('click', () => {
        document.getElementById('loginSection').style.display = 'block';
        document.getElementById('otpSection').classList.remove('show');
        clearInterval(timerInterval);
        document.getElementById('timerDisplay').textContent = '05:00';
    });

    // ================================================================
    // AUTO-SUBMIT OTP
    // ================================================================
    document.getElementById('otpInput').addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/\D/g, '');
        if (e.target.value.length === 6) {
            document.getElementById('verifyOtpBtn').click();
        }
    });

    // ================================================================
    // ENTER KEY
    // ================================================================
    document.getElementById('adminEmail').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('sendOtpBtn').click();
    });
    document.getElementById('otpInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') document.getElementById('verifyOtpBtn').click();
    });
</script>
</body>
</html>